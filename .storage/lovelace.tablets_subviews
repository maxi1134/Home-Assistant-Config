                {
                  "type": "markdown",
                  "content": "{#- Maxi 2026-11-03: header of the STM bus map for stop 52457 (opened from the hallway party-mode bus card).\n    Upcoming buses at this stop; a pin marks the ones with a GPS position (on the map below). -#}\n{%- set sensors = ['sensor.stm_52457_arrival_1', 'sensor.stm_52457_arrival_2', 'sensor.stm_52457_arrival_3'] -%}\n{%- set d = namespace(list=[], asof=none, onmap=0) -%}\n{%- for e in sensors -%}\n  {%- set m = states(e) | float(-1) -%}\n  {%- if m >= 0 -%}\n    {%- set gps = state_attr(e, 'location_source') == 'vehicle_position_message' -%}\n    {%- set d.list = d.list + [[m | int, state_attr(e, 'route_id') | string, state_attr(e, 'route_color') or '009EE0', gps]] -%}\n    {%- set d.onmap = d.onmap + (1 if gps else 0) -%}\n    {%- if d.asof is none or states[e].last_updated > d.asof -%}{%- set d.asof = states[e].last_updated -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- set first = d.list[0] if d.list else [none, '10', '009EE0', false] -%}\n{%- set station = 'Frontenac' if '52457' == '52383' and first[1] == '368' else 'Papineau' -%}\n{%- set t = namespace(s='') -%}\n{%- for x in d.list -%}\n  {%- set t.s = t.s ~ (' · ' if not loop.first else '') ~ ('<ha-icon icon=\"mdi:map-marker\"></ha-icon>' if x[3] else '')\n    ~ ('<small>' ~ x[1] ~ '</small> ' if x[1] != first[1] else '') ~ ('<b>' ~ x[0] ~ '</b>' if loop.first else x[0] | string) -%}\n{%- endfor -%}\n<table><tr>\n<td><font color=\"#{{ first[2] }}\"><b>{{ first[1] }}</b></font></td>\n<td><font color=\"#00B300\">●</font> {{ station }}<small><ha-icon icon=\"mdi:bus-stop\"></ha-icon>De Lorimier / Marie-Anne · <ha-icon icon=\"mdi:walk\"></ha-icon>1 min</small></td>\n<td>{{ (t.s ~ ' <small>min</small>') if d.list else '<small>no bus coming</small>' }}<small>{{ ((d.onmap ~ ' on the map') if d.onmap else 'none on the road yet') if d.list else '' }}{{ (' · ' ~ as_local(d.asof).strftime('%H:%M')) if d.asof else '' }}</small></td>\n</tr></table>",
                  "card_mod": {
