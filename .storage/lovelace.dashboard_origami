{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.dashboard_origami",
  "data": {
    "config": {
      "title": "Origami",
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home",
          "type": "sections",
          "max_columns": 3,
          "theme": "Origami Synthwave",
          "badges": [],
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "grid",
                  "square": false,
                  "columns": 2,
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "${(h => h < 5 ? 'Still awake?' : h < 22 ? 'Hello there' : 'Good night')(new Date().getHours())}",
                      "modules": [
                        "origami_base",
                        "origami_header"
                      ],
                      "origami_header": {
                        "value_position": "above",
                        "value_size": "var(--ha-font-size-s)",
                        "value_max_width": "100px"
                      },
                      "sub_button": {
                        "main": [
                          {
                            "entity": "calendar.maxi",
                            "show_icon": false,
                            "origami_header": {
                              "name": "${attr.message}"
                            },
                            "tap_action": {
                              "action": "none"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "custom:origami-notifications",
                      "weather": "weather.forecast_home",
                      "hide_when_empty": false,
                      "rotate": 3,
                      "entities": [
                        "sensor.weather_montreal_warnings",
                        {
                          "entity": "calendar.maxi",
                          "before": "24:00:00"
                        },
                        "timer.cooking",
                        {
                          "entity": "sensor.dryer_remaining_time_2",
                          "name": "Dryer"
                        },
                        "vacuum.roborock_qrevo_curv_series",
                        {
                          "entity": "lock.lock_front_door",
                          "name": "Front door"
                        }
                      ],
                      "css": ":host {\n  --origami-pad: var(--ha-space-4);\n  --origami-gap: var(--ha-space-4);\n  --origami-tile: var(--ha-space-10);\n  --origami-row-tile: var(--ha-space-12);\n  --origami-icon: var(--icon-size-m);\n  --origami-radius: var(--radius-inner);\n  --origami-card-bg: var(--fill-subtle);\n  --origami-row-bg: var(--fill-subtle);\n  --accent-color: var(--fill-active);\n  --ha-tile-icon-border-radius: var(--radius-inner);\n  --ha-tile-info-primary-font-size: var(--ha-font-size-m);\n  --ha-tile-info-primary-font-weight: var(--ha-font-weight-bold);\n  --ha-tile-info-secondary-font-size: var(--ha-font-size-s);\n  --ha-tile-info-secondary-font-weight: var(--ha-font-weight-medium);\n  --ha-tile-info-secondary-color: var(--secondary-text-color);\n}\nha-card { box-shadow: none; }\n.texts { min-height: calc(var(--origami-tile) + 2 * var(--origami-pad)); }\n.slide { gap: var(--ha-space-1); }\n.icon {\n  background: color-mix(in srgb, var(--tile-color) var(--tint-strength), var(--ha-card-background, var(--card-background-color)));\n  box-shadow: var(--ha-card-box-shadow, none);\n}\n.head .icon.idle { color: var(--primary-text-color); }\n.badge {\n  top: -6px;\n  inset-inline-end: -6px;\n  min-width: 20px;\n  height: 20px;\n  padding: 0 6px 0 6px;\n  border-radius: 10px;\n  font-size: 12px;\n  font-weight: var(--ha-font-weight-bold);\n  box-shadow: none;\n}\n.list { gap: var(--ha-space-2); }\n.row { padding: var(--ha-space-3); }\n.row .title {\n  font-size: var(--ha-font-size-m);\n  font-weight: var(--ha-font-weight-bold);\n}\n.row .message { font-size: var(--ha-font-size-s); }\n.heading {\n  font-weight: var(--ha-font-weight-bold);\n  font-size: var(--ha-font-size-l);\n}\n"
                    }
                  ]
                },
                {
                  "type": "custom:origami-weather",
                  "weather_entity": "weather.forecast_home",
                  "color_mode": "theme",
                  "card_height": "150px",
                  "card_padding": "0px 0px 0px 0px",
                  "card_offset": "20px 0px 0px 0px",
                  "card_tap_action": {
                    "action": "more-info"
                  },
                  "sun_moon_size": 40,
                  "sun_moon_x": "dynamic",
                  "shadow_color": "var(--tile-chip-shadow)",
                  "cloud_effects": false,
                  "background_mode": "images",
                  "weather_image_path": "https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/",
                  "weather_image_path_dark": "https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/",
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  },
                  "content_direction": "row",
                  "content_align": "end",
                  "css": "/* Origami Weather with the Origami theme's values */\n:host {\n  --origami-text-light: var(--primary-text-color);\n  --origami-text-dark: var(--primary-text-color);\n  --origami-bottom-font-weight: var(--ha-font-weight-normal);\n  --origami-bottom-bg-filter: var(--blur-soft);\n  /* A chip's corner is 35 % of its height: the text and 6px above and below it */\n  --origami-bottom-bg-radius: calc((1em + 12px) * var(--radius-ratio));\n}\n/* The pictures have a clear sky, and the card paints the paper in the weather's color. Each picture is also the mask of the sky,\n   so the sun, the moon and the stars show only in the open sky and set behind the hills, the trees and the clouds. */\n#card-root { --paper: #e2e5e7; --sky: none; }\n#card-root.scheme-dark { --paper: #1b1e20; }\n#card-root.weather-sunny { --paper: #eee5d7; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/sunny.webp\"); }\n#card-root.scheme-dark.weather-sunny { --paper: #261d13; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/sunny.webp\"); }\n#card-root.weather-partlycloudy { --paper: #dee9ef; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/partlycloudy.webp\"); }\n#card-root.scheme-dark.weather-partlycloudy { --paper: #182227; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/partlycloudy.webp\"); }\n#card-root.weather-cloudy { --paper: #e2e5e7; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/cloudy.webp\"); }\n#card-root.scheme-dark.weather-cloudy { --paper: #1b1e20; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/cloudy.webp\"); }\n#card-root.weather-fog { --paper: #e8e7e5; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/fog.webp\"); }\n#card-root.scheme-dark.weather-fog { --paper: #222120; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/fog.webp\"); }\n#card-root.weather-rainy { --paper: #d9e1ea; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/rainy.webp\"); }\n#card-root.scheme-dark.weather-rainy { --paper: #171e26; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/rainy.webp\"); }\n#card-root.weather-pouring { --paper: #d7dde4; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/pouring.webp\"); }\n#card-root.scheme-dark.weather-pouring { --paper: #151b21; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/pouring.webp\"); }\n#card-root.weather-lightning { --paper: #e5dfe8; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/lightning.webp\"); }\n#card-root.scheme-dark.weather-lightning { --paper: #221d25; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/lightning.webp\"); }\n#card-root.weather-lightning-rainy { --paper: #dfdbe2; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/lightning-rainy.webp\"); }\n#card-root.scheme-dark.weather-lightning-rainy { --paper: #1d1920; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/lightning-rainy.webp\"); }\n#card-root.weather-hail { --paper: #d3dfdf; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/hail.webp\"); }\n#card-root.scheme-dark.weather-hail { --paper: #121c1c; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/hail.webp\"); }\n#card-root.weather-snowy { --paper: #e5eaec; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/snowy.webp\"); }\n#card-root.scheme-dark.weather-snowy { --paper: #1c2426; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/snowy.webp\"); }\n#card-root.weather-snowy-rainy { --paper: #dde2e5; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/snowy-rainy.webp\"); }\n#card-root.scheme-dark.weather-snowy-rainy { --paper: #1e2124; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/snowy-rainy.webp\"); }\n#card-root.weather-windy { --paper: #dce6e3; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/windy.webp\"); }\n#card-root.scheme-dark.weather-windy { --paper: #182220; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/windy.webp\"); }\n#card-root.weather-windy-variant { --paper: #dae1de; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/windy-variant.webp\"); }\n#card-root.scheme-dark.weather-windy-variant { --paper: #171d1b; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/windy-variant.webp\"); }\n#card-root.weather-clear-night { --paper: #e0e3ed; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/clear-night.webp\"); }\n#card-root.scheme-dark.weather-clear-night { --paper: #161924; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/clear-night.webp\"); }\n#card-root.weather-exceptional { --paper: #eadad3; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/exceptional.webp\"); }\n#card-root.scheme-dark.weather-exceptional { --paper: #271a15; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/exceptional.webp\"); }\n#card-root.scheme-light, #card-root.scheme-dark { background-color: var(--paper); }\n/* The landscape stands at the bottom left, however wide the card is */\n#weather-bg > img { object-position: left bottom; }\n#card-root.has-weather-bg :is(#sun-moon-layer, #star-canvas) {\n  -webkit-mask-image: var(--sky), linear-gradient(#000 0 0);\n  -webkit-mask-position: left bottom, 0 0;\n  -webkit-mask-size: cover, 100% 100%;\n  -webkit-mask-repeat: no-repeat;\n  -webkit-mask-composite: xor;\n  mask-image: var(--sky), linear-gradient(#000 0 0);\n  mask-position: left bottom, 0 0;\n  mask-size: cover, 100% 100%;\n  mask-repeat: no-repeat;\n  mask-composite: exclude;\n}\n/* The paper changes softly with the weather, and a new picture fades in */\n@media (prefers-reduced-motion: no-preference) {\n  #card-root.scheme-light, #card-root.scheme-dark { transition: background-color 1.2s var(--ease-standard), transform .4s cubic-bezier(.2, 0, .2, 1); }\n  #weather-bg > img { animation: appear .9s var(--ease-standard) both; }\n}\n@keyframes appear { from { opacity: 0; } }\n/* Rain, snow, birds and planes in calmer colors */\n#weather-effects { filter: saturate(.6); }\n/* On a wide screen, the heading above the card sets the space */\n@media (min-width: 768px) { :host { margin: 0px 0px 0px 0px !important; } }\n",
                  "button_containers": [
                    {
                      "position": "custom",
                      "position_anchor": "top-left",
                      "padding": "16px 16px 16px 16px",
                      "button_gap": "6px",
                      "buttons": [
                        {
                          "entity": "sun.sun",
                          "visibility": [
                            {
                              "condition": "state",
                              "entity": "sun.sun",
                              "state": "above_horizon"
                            }
                          ],
                          "elements": [
                            {
                              "type": "icon",
                              "icon": "mdi:weather-sunset-down"
                            },
                            {
                              "type": "text",
                              "entity": "sun.sun",
                              "attribute": "next_setting",
                              "size": "12px",
                              "weight": "700",
                              "color": "var(--primary-text-color)"
                            }
                          ]
                        },
                        {
                          "entity": "sun.sun",
                          "visibility": [
                            {
                              "condition": "state",
                              "entity": "sun.sun",
                              "state": "below_horizon"
                            }
                          ],
                          "elements": [
                            {
                              "type": "icon",
                              "icon": "mdi:weather-sunset-up"
                            },
                            {
                              "type": "text",
                              "entity": "sun.sun",
                              "attribute": "next_rising",
                              "size": "12px",
                              "weight": "700",
                              "color": "var(--primary-text-color)"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "position": "custom",
                      "position_anchor": "top-right",
                      "align": "end",
                      "padding": "16px 20px 16px 20px",
                      "buttons": [
                        {
                          "entity": "weather.forecast_home",
                          "style": "vertical",
                          "inner_gap": "6px",
                          "padding": "0px 0px 0px 0px",
                          "elements": [
                            {
                              "type": "text",
                              "attribute": "temperature",
                              "precision": 0,
                              "format": "°",
                              "size": "40px",
                              "weight": "700",
                              "color": "var(--primary-text-color)"
                            },
                            {
                              "type": "text",
                              "size": "12px",
                              "weight": "500"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "custom:bubble-card",
                  "card_type": "separator",
                  "name": "Favorites",
                  "modules": [
                    "origami_base",
                    "origami_header"
                  ],
                  "origami_header": {
                    "weight": "medium",
                    "icon_size": "var(--icon-size-m)"
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  },
                  "sub_button": {
                    "main": [
                      {
                        "name": "All",
                        "icon": "mdi:chevron-right",
                        "show_name": true,
                        "content_layout": "icon-right",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#popup_favorites"
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "custom:bubble-card",
                  "card_type": "sub-buttons",
                  "modules": [
                    "origami_base",
                    "origami_tiles"
                  ],
                  "origami_tiles": {
                    "scroll": true
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  },
                  "sub_button": {
                    "bottom": [
                      {
                        "name": "Music",
                        "entity": "media_player.mass_workshop_wiim_speaker",
                        "icon": "mdi:speaker",
                        "force_icon": true,
                        "origami_tiles": {
                          "color": "var(--state-media_player-active-color)",
                          "state": "${(p => p ? name(p) : '')(['media_player.mass_workshop_wiim_speaker', 'media_player.mass_kitchen_wiim_speaker', 'media_player.mass_hallway_wiim_speaker', 'media_player.mass_lounge_wiim_speaker', 'media_player.mass_hotbox_wiim_speaker', 'media_player.mass_patio_wiim_speaker', 'media_player.mass_bathroom_vpe_speaker', 'media_player.mass_bedroom_vpe_speaker'].find(e => states(e) === 'playing'))}",
                          "image": "${(p => p ? hass.states[p].attributes.entity_picture : '')(['media_player.mass_workshop_wiim_speaker', 'media_player.mass_kitchen_wiim_speaker', 'media_player.mass_hallway_wiim_speaker', 'media_player.mass_lounge_wiim_speaker', 'media_player.mass_hotbox_wiim_speaker', 'media_player.mass_patio_wiim_speaker', 'media_player.mass_bathroom_vpe_speaker', 'media_player.mass_bedroom_vpe_speaker'].find(e => states(e) === 'playing'))}"
                        },
                        "visibility": [
                          {
                            "condition": "or",
                            "conditions": [
                              {
                                "condition": "state",
                                "entity": "media_player.mass_workshop_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_kitchen_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_hallway_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_lounge_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_hotbox_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_patio_wiim_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_bathroom_vpe_speaker",
                                "state": "playing"
                              },
                              {
                                "condition": "state",
                                "entity": "media_player.mass_bedroom_vpe_speaker",
                                "state": "playing"
                              }
                            ]
                          }
                        ],
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#popup_music"
                        },
                        "hold_action": {
                          "action": "more-info"
                        }
                      },
                      {
                        "name": "Shopping",
                        "entity": "todo.shopping_list",
                        "icon": "mdi:cart-outline",
                        "origami_tiles": {
                          "name": "${num(state, 0)} ${Number(state) === 1 ? 'item' : 'items'}",
                          "state": "To buy"
                        },
                        "visibility": [
                          {
                            "condition": "numeric_state",
                            "entity": "todo.shopping_list",
                            "above": 0
                          }
                        ],
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "/todo?entity_id=todo.shopping_list"
                        },
                        "hold_action": {
                          "action": "more-info"
                        }
                      },
                      {
                        "name": "TV",
                        "entity": "media_player.universal_salon_chromecast",
                        "icon": "mdi:television",
                        "visibility": [
                          {
                            "condition": "state",
                            "entity": "media_player.universal_salon_chromecast",
                            "state_not": [
                              "off",
                              "standby",
                              "unavailable",
                              "unknown"
                            ]
                          }
                        ],
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#popup_tv"
                        },
                        "hold_action": {
                          "action": "more-info"
                        }
                      },
                      {
                        "name": "Vacuum",
                        "entity": "vacuum.roborock_qrevo_curv_series",
                        "icon": "mdi:robot-vacuum",
                        "force_icon": true,
                        "origami_tiles": {
                          "name": "${(p => ['docked', 'returning'].includes(state) || p >= 99 ? 'Vacuum' : Number.isNaN(p) ? '' : p < 0 ? 'Error' : num(p, 0, '%'))(Math.round(states('sensor.roborock_qrevo_curv_series_cleaning_progress')))}",
                          "state": {
                            "docked": "${word('off')}",
                            "idle": "${word('off')}",
                            "cleaning": "Vacuum"
                          },
                          "order": {
                            "cleaning": -1
                          }
                        },
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#popup_vacuum"
                        },
                        "hold_action": {
                          "action": "more-info"
                        }
                      },
                      {
                        "name": "Timer",
                        "entity": "timer.cooking",
                        "icon": "mdi:timer-outline",
                        "origami_tiles": {
                          "name": {
                            "active": "${num(minutesUntil('timer.cooking'), 0, 'minute')}"
                          },
                          "color": "var(--amber-color)",
                          "order": -2
                        },
                        "visibility": [
                          {
                            "condition": "state",
                            "entity": "timer.cooking",
                            "state_not": "idle"
                          }
                        ],
                        "tap_action": {
                          "action": "more-info"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:bubble-card",
                  "card_type": "separator",
                  "name": "Rooms",
                  "modules": [
                    "origami_base",
                    "origami_header"
                  ],
                  "origami_header": {
                    "weight": "medium",
                    "value_style": "chip",
                    "icon_size": "var(--icon-size-l)"
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  },
                  "sub_button": {
                    "main": [
                      {
                        "name": "Temperature",
                        "icon": "mdi:thermometer",
                        "origami_header": {
                          "name": "${(t => t.length ? num(t.reduce((a, b) => a + b, 0) / t.length, 0) + '°' : '–')( ['sensor.sensor_salon_temperature_temperature', 'sensor.sensor_kitchen_temperature_temperature', 'sensor.sensor_workshop_temperature_temperature', 'sensor.sensor_bedroom_temperature_temperature', 'sensor.sensor_bathroom_temperature_temperature', 'sensor.sensor_hotbox_down_temperature_temperature', 'sensor.sensor_server_temperature_temperature'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}"
                        },
                        "tap_action": {
