            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#vacuum",
              "button_type": "name",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_tiles"
                      ],
                      "origami_tiles": {
                        "layout": "grid",
                        "columns": 1
                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "entity": "sensor.roborock_qrevo_curv_series_status",
                            "name": "Status",
                            "icon": "mdi:robot-vacuum",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": false,
                            "tap_action": {
                              "action": "more-info"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_tiles"
                      ],
                      "origami_tiles": {
                        "layout": "grid",
                        "columns": 2
                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "entity": "sensor.roborock_qrevo_curv_series_battery",
                            "name": "Battery",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": false,
                            "tap_action": {
                              "action": "more-info"
                            }
                          },
                          {
                            "entity": "sensor.roborock_qrevo_curv_series_current_room",
                            "name": "Room",
                            "icon": "mdi:map-marker",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": false,
                            "tap_action": {
                              "action": "more-info"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "vertical-stack",
                      "cards": [
                        {
                          "type": "tile",
                          "entity": "vacuum.roborock_qrevo_curv_series",
                          "name": "Robot",
                          "state_content": [
                            "state",
                            "fan_speed"
                          ],
                          "features_position": "inline",
                          "features": [
                            {
                              "type": "vacuum-commands",
                              "commands": [
                                "start_pause",
                                "stop",
                                "clean_spot",
                                "locate",
                                "return_home"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "binary_sensor.roborock_qrevo_curv_series_dock_clean_water_box",
                              "state": "on"
                            }
                          ],
                          "card": {
                            "type": "tile",
                            "entity": "binary_sensor.roborock_qrevo_curv_series_dock_clean_water_box",
                            "name": "Clean water tank",
                            "color": "red"
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "binary_sensor.roborock_qrevo_curv_series_dock_dirty_water_box",
                              "state": "on"
                            }
                          ],
                          "card": {
                            "type": "tile",
                            "entity": "binary_sensor.roborock_qrevo_curv_series_dock_dirty_water_box",
                            "name": "Dirty water tank",
                            "color": "red"
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "binary_sensor.roborock_qrevo_curv_series_water_shortage",
                              "state": "on"
                            }
                          ],
                          "card": {
                            "type": "tile",
                            "entity": "binary_sensor.roborock_qrevo_curv_series_water_shortage",
                            "name": "Water shortage",
                            "color": "red"
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "sensor.roborock_qrevo_curv_series_dock_dock_error",
                              "state_not": "ok"
                            }
                          ],
                          "card": {
                            "type": "tile",
                            "entity": "sensor.roborock_qrevo_curv_series_dock_dock_error",
                            "name": "Dock",
                            "color": "red"
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "sensor.roborock_qrevo_curv_series_vacuum_error",
                              "state_not": "none"
