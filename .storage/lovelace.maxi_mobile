olor:var(--accent-color);--success-color:var(--green-color);--warning-color:var(--orange-color);--error-color:var(--red-color);--tint:color-mix(in srgb, currentColor var(--tint-strength), var(--ha-card-background));--lamp-color:var(--state-light-active-color);--heat-color:var(--state-climate-heat-color);--water-color:var(--state-climate-cool-color);--media-color:var(--state-media_player-active-color);--ok-color:var(--success-color);--control-switch-on-color:var(--toggle-on);--control-switch-off-color:var(--grey-color);--wa-color-on-normal:var(--primary-text-color);--ha-ripple-color:var(--card-item-background);--ha-ripple-hover-color:var(--accent-color-background);--ha-ripple-pressed-color:var(--accent-color-background);--ha-ripple-hover-opacity:0.1;--ha-ripple-pressed-opacity:0.2;--input-ink-color:var(--primary-text-color);--input-label-ink-color:var(--primary-text-color);--input-fill-color:var(--fill-subtle);--input-idle-line-color:var(--background-color);--input-hover-line-color:var(--primary-color);--input-disabled-line-color:var(--fill-subtle);--input-dropdown-icon-color:var(--secondary-text-color);--input-disabled-fill-color:var(--background-color);--input-disabled-ink-color:var(--disabled-text-color);--mdc-text-field-label-ink-color:var(--secondary-text-color);--mdc-theme-surface:var(--ha-card-background);--mdc-theme-on-secondary:var(--text-color-active);--ha-heading-card-title-font-weight:var(--ha-font-weight-bold);--ha-color-fill-primary-quiet-resting:var(--ha-card-background);--button-color-fill-normal-hover:color-mix(in srgb, var(--accent-color) 26%, var(--ha-card-background) 74%);--button-color-fill-normal-active:color-mix(in srgb, var(--accent-color) 34%, var(--background-color) 66%);--info-color:var(--accent-color);--bubble-main-background-color:var(--ha-card-background);--bubble-secondary-background-color:var(--card-item-background);--bubble-icon-background-color:var(--card-item-background);--bubble-pop-up-main-background-color:var(--popup-background);--bubble-backdrop-background-color:var(--backdrop-background-color);--bubble-border-radius:var(--ha-card-border-radius);--bubble-accent-color:var(--accent-color);--bubble-light-color:color-mix(in srgb, var(--lamp-color) var(--fill-strength), var(--ha-card-background));--bubble-line-background-color:var(--secondary-text-color);--bubble-sub-button-light-background-color:var(--accent-color-background);--bubble-select-list-background-color:var(--ha-card-background);--bubble-select-main-background-color:var(--ha-card-background);--bubble-select-list-width:140px;--bubble-select-list-item-accent-color:var(--fill-subtle);--card-padding:var(--ha-space-3, 12px);--control-padding-x:var(--ha-space-4, 16px);--font-size-headline:var(--ha-font-size-3xl, 28px);--font-size-compact:var(--ha-font-size-s);--lamp-tint:color-mix(in srgb, var(--lamp-color) var(--tint-strength), var(--ha-card-background));--scroller-mask:linear-gradient(to right, transparent 0px, black var(--scroller-bleed), black calc(100% - var(--ha-space-12, 48px)), transparent 100%);--border-contrast:8%;--background-color:#241B2F;--dashboard-background:#241B2F;--ha-card-background:#34294F;--popup-background:#2A2139;--tile-chip-background:var(--fill-strong);--primary-text-color:#FFFFFF;--secondary-text-color:color-mix(in srgb, var(--primary-text-color) 70%, transparent);--fill-base:#E9DDFF;--fill-contrast:6%;--icon-color:#B4A6D6;--disabled-text-color:#6B5F86;--primary-color:#F92AAD;--accent-color:#F92AAD;--dark-primary-color:#B81F80;--light-primary-color:var(--ha-card-background);--amber-color:#FFCC00;--orange-color:#FF8B39;--deep-orange-color:#F97E72;--red-color:#FE4450;--pink-color:#FF7EDB;--purple-color:#C792EA;--deep-purple-color:#9D7CD8;--indigo-color:#848BBD;--blue-color:#6E9CFF;--light-blue-color:#72C8FF;--cyan-color:#36F9F6;--teal-color:#00EEE4;--green-color:#72F1B8;--light-green-color:#A6F18C;--lime-color:#D4F17B;--yellow-color:#FEDE5D;--brown-color:#B3836B;--light-grey-color:#B9B0CC;--grey-color:#8B82A3;--dark-grey-color:#564C6E;--blue-grey-color:#8F97B8;--tint-strength:12%;--fill-strength:35%;--shadow-tint:10, 4, 20;--shadow-edge:inset 0 0.5px 0 rgba(255, 255, 255, 0.07), 0 0 0 0.5px rgba(var(--shadow-tint), 0.35);--card-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 6px 14px -6px rgba(var(--shadow-tint), 0.5);--chip-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 3px 7px -3px rgba(var(--shadow-tint), 0.45);--card-shadow-color:rgba(var(--shadow-tint), 0.65);--shadow-elevated:var(--shadow-edge), 0 2px 6px -2px rgba(var(--shadow-tint), 0.5), 0 20px 48px -12px rgba(var(--shadow-tint), 0.7);--shadow-sheet:var(--shadow-edge), 0 -1px 3px rgba(var(--shadow-tint), 0.25), 0 -4px 12px rgba(var(--shadow-tint), 0.25), 0 -12px 32px rgba(var(--shadow-tint), 0.35);--navbar-shadow:0px -1px 2px rgba(var(--shadow-tint), 0.3), 0px -10px 28px -8px rgba(var(--shadow-tint), 0.55);--ha-color-fill-primary-loud-hover:color-mix(in srgb, var(--accent-color) 90%, #000000 10%);--ha-color-fill-primary-loud-active:color-mix(in srgb, var(--accent-color) 80%, #000000 20%);--rgb-secondary-text-color:179, 172, 192;--rgb-card-background-color:52, 41, 79;--rgb-error-color:254, 68, 80;--rgb-warning-color:255, 139, 57;--rgb-success-color:114, 241, 184;--rgb-info-color:249, 42, 173;--ha-color-primary-05:#1A0412;--ha-color-primary-10:#2E0720;--ha-color-primary-20:#520C39;--ha-color-primary-30:#7A1255;--ha-color-primary-40:#A31871;--ha-color-primary-50:#D0208F;--ha-color-primary-60:#F92AAD;--ha-color-primary-70:#FB62C2;--ha-color-primary-80:#FC95D6;--ha-color-primary-90:#FEC8EA;--ha-color-primary-95:#FFE4F5;--ha-card-background:#3A2766;--rgb-card-background-color:58,39,102;--popup-background:#24173D;--fill-base:#FF7EDB;--fill-contrast:20%;--fill-strong:color-mix(in srgb,#FF7EDB 28%,transparent);--fill-loud:color-mix(in srgb,#36F9F6 70%,transparent);--toggle-on:#F92AAD;--fill-active:#F92AAD;--text-color-active:#1A0F2E;--tint-strength:24%;--fill-strength:45%;--state-media_player-active-color:#36F9F6;--media-color:#36F9F6;--accent-color:#F92AAD;--primary-color:#F92AAD;--track-color:color-mix(in srgb,#36F9F6 22%,transparent);--icon-color:#36F9F6;--secondary-text-color:#C9B6F2;--tile-chip-background:color-mix(in srgb,#F92AAD 18%,#3A2766);--chip-shadow:0 0 0 0.5px rgba(249,42,173,.35),0 2px 10px -2px rgba(249,42,173,.45);--card-shadow:inset 0 0.5px 0 rgba(255,255,255,.08),0 0 0 0.5px rgba(54,249,246,.25),0 6px 18px -6px rgba(249,42,173,.45) }\n"
            },
            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#security_popup",
              "button_type": "name",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "slider_fill_orientation": "left",
              "slider_value_position": "right",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Doors",
                      "modules": [
                        "origami_header"
                      ]
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_tiles"
                      ],
                      "origami_tiles": {
                        "layout": "grid",
                        "columns": 2
                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "entity": "lock.lock_front_door",
                            "name": "Front",
                            "icon": "mdi:lock",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": true,
                            "tap_action": {
                              "action": "more-info"
                            }
                          },
                          {
                            "entity": "lock.back_door",
                            "name": "Kitchen",
                            "icon": "mdi:lock",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": true,
                            "tap_action": {
                              "action": "more-info"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Alarm",
                      "modules": [
                        "origami_header"
                      ],
                      "sub_button": {
                        "main": [
                          {
                            "entity": "alarm_control_panel.home_alarm",
                            "show_state": true,
                            "show_icon": false,
                            "show_background": false
                          }
                        ],
                        "bottom": []
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_tiles"
                      ],
                      "origami_tiles": {
                        "layout": "grid",
                        "columns": 2
                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "name": "Off",
                            "icon": "mdi:shield-off-outline",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_disarm",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_disarm",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            }
                          },
                          {
                            "name": "Home",
                            "icon": "mdi:shield-home",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_home",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_home",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            }
                          },
                          {
                            "name": "Away",
                            "icon": "mdi:shield-lock",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_away",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_away",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            }
                          },
                          {
                            "name": "Night",
                            "icon": "mdi:shield-moon",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_night",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "alarm_control_panel.alarm_arm_night",
                              "target": {
                                "entity_id": "alarm_control_panel.home_alarm"
                              }
                            }
                          }
                        ]
                      },
                      "styles": "${(i => i ? '.bubble-sub-button-' + i + ' { background: linear-gradient(135deg, #F92AAD, #9D4EDD) !important; color: #fff !important; } .bubble-sub-button-' + i + ' ha-icon { color: #fff !important; }' : '')({disarmed: 1, armed_home: 2, armed_away: 3, armed_night: 4}[hass.states['alarm_control_panel.home_alarm']?.state])}"
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_tiles"
                      ],
                      "origami_tiles": {
                        "layout": "grid",
                        "columns": 1
                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "entity": "input_boolean.maxi_is_scared",
                            "name": "Auto back siren",
                            "icon": "mdi:air-horn",
                            "show_name": true,
                            "show_state": true,
                            "show_icon": true,
                            "tap_action": {
                              "action": "toggle"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Front door",
                      "modules": [
                        "origami_header"
                      ]
                    },
                    {
                      "type": "custom:advanced-camera-card",
                      "elements": [
                        {
                          "type": "custom:advanced-camera-card-menu-state-icon",
                          "entity": "lock.lock_front_door",
                          "tap_action": {
                            "action": "toggle"
                          }
                        },
                        {
                          "type": "custom:advanced-camera-card-menu-state-icon",
                          "entity": "light.front_door_light",
                          "tap_action": {
                            "action": "toggle"
                          },
                          "hold_action": {
                            "action": "more-info"
                          }
                        },
                        {
                          "type": "custom:advanced-camera-card-conditional",
                          "conditions": [
                            {
                              "condition": "view",
                              "views": [
                                "live"
                              ]
                            }
                          ]
                        }
                      ],
                      "live": {
                        "draggable": true,
                        "lazy_load": true,
                        "preload": true,
                        "transition_effect": "slide",
