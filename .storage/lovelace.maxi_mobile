                            "tap_action": {
                              "action": "toggle"
                            }
                          }
                        ],
                        "bottom": []
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "${((h, g) => !!h && !['off', 'unavailable', 'unknown'].includes(h.state) && g.length > 1 && (h.attributes.group_members ?? []).length === g.length && g.every(x => (h.attributes.group_members ?? []).includes(x)))(hass.states['media_player.group_mass_home_group_speakers'], (e => hass.states[e]?.attributes?.group_members ?? [])('media_player.mass_salon_wiim_speaker')) ? 'Home Group' : 'Salon group'}",
                      "modules": [
                        "origami_header"
                      ],
                      "sub_button": {
                        "main": [
                          {
                            "name": "Ungroup",
                            "icon": "mdi:link-variant-off",
                            "show_name": true,
                            "origami_header": {
                              "hidden": "${((h, g) => !!h && !['off', 'unavailable', 'unknown'].includes(h.state) && g.length > 1 && (h.attributes.group_members ?? []).length === g.length && g.every(x => (h.attributes.group_members ?? []).includes(x)))(hass.states['media_player.group_mass_home_group_speakers'], (e => hass.states[e]?.attributes?.group_members ?? [])('media_player.mass_salon_wiim_speaker'))}",
                              "icon": "${states('script.origami_group_speakers') === 'on' ? 'mdi:timer-sand' : ''}",
                              "disabled": "${states('script.origami_group_speakers') === 'on'}"
                            },
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_group_speakers",
                              "data": {
                                "speaker": "media_player.mass_salon_wiim_speaker",
                                "ungroup": true
                              },
                              "confirmation": {
                                "text": "Ungroup these speakers?"
                              }
                            }
                          },
                          {
                            "name": "Edit",
                            "icon": "mdi:chevron-down",
                            "show_name": true,
                            "origami_header": {
                              "icon": "${states('input_select.origami_volume_edit') !== 'media_player.mass_salon_wiim_speaker' ? 'mdi:chevron-down' : 'mdi:chevron-up'}"
                            },
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_volume_edit_toggle",
                              "data": {
                                "section": "media_player.mass_salon_wiim_speaker"
                              }
                            }
                          }
                        ],
                        "bottom": []
