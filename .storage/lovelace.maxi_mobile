            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#volume-pop-up",
              "button_type": "name",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Speakers",
                      "modules": [
                        "origami_header"
                      ],
                      "sub_button": {
                        "main": [
                          {
                            "name": "Equalize",
                            "icon": "mdi:equal",
                            "show_name": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.equalize_home_group_volume"
                            }
                          },
                          {
                            "entity": "media_player.group_mass_home_group_speakers",
                            "icon": "mdi:power",
