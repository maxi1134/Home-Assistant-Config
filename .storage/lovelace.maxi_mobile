                      "button_type": "state",
                      "entity": "input_select.origami_selected_speaker",
                      "icon": "mdi:music-note",
                      "name": "${(p => (src => !p || ['unavailable', 'unknown'].includes(p.state) ? 'Unavailable' : /bluetooth|optical|coax|hdmi|line|aux|\\btv\\b/i.test(src) ? format(p.entity_id, 'source') : 'Nothing playing')(String(p?.attributes?.source ?? '')))(hass.states[(s => hass.states[s]?.attributes?.group_members?.[0] ?? s)(states('input_select.origami_selected_speaker'))])}",
                      "modules": [
                        "origami_base",
                        "origami_media",
                        "!default"
                      ],
                      "show_icon": false,
                      "scrolling_effect": true,
                      "cover_background": false,
                      "tap_action": {
                        "action": "none"
                      },
                      "button_action": {
                        "tap_action": {
                          "action": "none"
                        }
                      },
                      "hide": {
                        "power_button": true,
                        "previous_button": true,
                        "next_button": true,
                        "volume_button": true,
                        "play_pause_button": true
                      },
                      "origami_base": {
                        "frameless": true,
                        "words": {
                          "media_player.mass_salon_wiim_speaker": "Salon",
                          "media_player.mass_lounge_wiim_speaker": "Lounge",
                          "media_player.mass_hallway_wiim_speaker": "Hallway",
                          "media_player.mass_workshop_wiim_speaker": "Workshop",
                          "media_player.mass_bedroom_vpe_speaker": "Bedroom",
                          "media_player.mass_kitchen_wiim_speaker": "Kitchen",
                          "media_player.mass_hotbox_wiim_speaker": "Hotbox",
                          "media_player.mass_bathroom_vpe_speaker": "Bathroom",
                          "media_player.mass_closet_aux2_speaker": "Closet",
                          "media_player.mass_patio_wiim_speaker": "Patio"
                        },
                        "animate": true
                      },
                      "origami_media": {
                        "cover": "${(s => ['playing', 'paused', 'buffering'].includes(hass.states[hass.states[s]?.attributes?.active_child ?? s]?.state) ? 'above' : 'icon')(states('input_select.origami_selected_speaker'))}",
                        "leader": "${(s => ((g, s) => !!g && !['off', 'unavailable', 'unknown'].includes(g.state) && !!g.attributes.active_queue && hass.states[hass.states[s]?.attributes?.active_child ?? s]?.attributes?.active_queue === g.attributes.active_queue)(hass.states['media_player.group_mass_home_group_speakers'], s) ? 'media_player.group_mass_home_group_speakers' : hass.states[s]?.attributes?.group_members?.[0] ?? s)(states('input_select.origami_selected_speaker'))}",
                        "state": "${(p => (src => !p || ['unavailable', 'unknown'].includes(p.state) ? 'Unavailable' : /bluetooth/i.test(src) ? 'Played from a phone' : /optical|coax|hdmi|line|aux|\\btv\\b/i.test(src) ? format(p.entity_id, 'source') : '')(String(p?.attributes?.source ?? '')))(hass.states[(s => hass.states[s]?.attributes?.group_members?.[0] ?? s)(states('input_select.origami_selected_speaker'))])}",
                        "icons": {
                          "bluetooth": "mdi:bluetooth",
                          "tv": "mdi:television",
                          "line": "mdi:audio-input-rca",
                          "idle": "mdi:music-note-off",
                          "on": "mdi:music-note-off",
                          "off": "mdi:music-note-off",
                          "unavailable": "mdi:speaker-off"
                        },
                        "icon_color": {
                          "bluetooth": "var(--media-color)",
                          "tv": "var(--primary-text-color)",
                          "line": "var(--primary-text-color)",
                          "idle": "var(--disabled-color)",
                          "on": "var(--disabled-color)",
                          "off": "var(--disabled-color)",
                          "unavailable": "var(--disabled-color)"
                        }
                      },
                      "rows": "auto",
                      "sub_button": {
                        "bottom_layout": "rows",
                        "main": [
                          {
                            "icon": "mdi:link-variant",
                            "sub_button_type": "default",
                            "show_background": true,
                            "origami_base": {
                              "on": "${(hass.states[states('input_select.origami_selected_speaker')]?.attributes?.group_members?.length ?? 0) > 1}"
                            },
                            "tap_action": {
                              "action": "fire-dom-event",
                              "mini_popup": "group"
                            }
                          }
                        ],
                        "bottom": [
                          {
                            "name": "Playback",
                            "group": [
                              {
                                "icon": "mdi:shuffle-variant",
                                "sub_button_type": "default",
                                "origami_base": {
                                  "dot": "${(p => ['playing', 'paused'].includes(p?.state) && p.attributes.shuffle === true)(hass.states[states('input_select.origami_selected_speaker')])}",
                                  "disabled": "${(p => !['playing', 'paused'].includes(p?.state) || p.attributes.shuffle === undefined)(hass.states[states('input_select.origami_selected_speaker')])}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.origami_playback",
