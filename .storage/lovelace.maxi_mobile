                                  }
                                },
                                "visibility": [
                                  {
                                    "condition": "template",
                                    "value_template": "{% set g = 'media_player.group_mass_home_group_speakers' %} {% set q = state_attr(g, 'active_queue') %} {% set home = states(g) not in ['off', 'unavailable', 'unknown'] and q is not none\n   and state_attr(state_attr(states('input_select.origami_selected_speaker'), 'active_child') or states('input_select.origami_selected_speaker'), 'active_queue') == q %}\n{{ not home }}"
                                  }
                                ]
                              },
                              {
                                "icon": "mdi:skip-previous",
                                "sub_button_type": "default",
                                "origami_base": {
                                  "disabled": "${!['playing', 'paused'].includes(states(states('input_select.origami_selected_speaker')))}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.origami_playback",
                                  "data": {
