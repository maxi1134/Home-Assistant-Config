                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
                        "origami_base",
                        "origami_button"
                      ],
                      "origami_base": {
                        "hidden": "${states('input_select.origami_selected_tv') !== 'media_player.universal_hotbox_top_chromecast'}"
                      },
                      "origami_button": {
                        "background": false,
                        "align": "center",
                        "icon_size": "var(--icon-size-l)",
                        "padding": "var(--ha-space-2) 0 0 0"
                      },
                      "styles": "ha-card .bubble-sub-button-bottom-container {\n  display: grid !important;\n  grid-template-columns: minmax(0, 1fr) repeat(3, var(--control-height-lg)) minmax(0, 1fr);\n  grid-template-rows: repeat(3, var(--control-height-lg));\n  grid-template-areas: \"back . up . home\" \". left ok right .\" \". . down . .\";\n  place-items: center;\n}\nha-card .bubble-sub-button-bottom-container::before {\n  content: \"\";\n  grid-area: 1 / 2 / 4 / 5;\n  place-self: stretch;\n  border-radius: var(--radius-circle);\n  background-color: var(--fill-subtle);\n  box-shadow: var(--card-ring);\n}\nha-card .bubble-sub-button-bottom-container .bubble-sub-button {\n  width: var(--control-height) !important;\n  height: var(--control-height) !important;\n  padding: 0 !important;\n  color: var(--primary-text-color) !important;\n}\nha-card .bubble-sub-button-bottom-container .bubble-sub-button .bubble-sub-button-icon:not(.hidden) {\n  opacity: var(--opacity-strong) !important;\n}\nha-card .bubble-sub-button-bottom-container .bubble-sub-button:is(.back, .home) {\n  width: var(--control-height-sm) !important;\n  height: var(--control-height-sm) !important;\n  border-radius: var(--ha-card-border-radius) !important;\n  background-color: var(--fill-subtle) !important;\n  box-shadow: var(--card-ring) !important;\n  --org-btn-icon-size: var(--icon-size-m);\n}\nha-card .bubble-sub-button-bottom-container .bubble-sub-button.ok {\n  width: var(--control-height-lg) !important;\n  height: var(--control-height-lg) !important;\n  border-radius: var(--radius-circle) !important;\n  background-color: var(--ha-card-background) !important;\n  box-shadow: var(--ha-card-box-shadow) !important;\n}\nha-card .bubble-sub-button-bottom-container .bubble-sub-button.ok .bubble-sub-button-name-container {\n  font-size: var(--ha-font-size-m) !important;\n  font-weight: var(--ha-font-weight-bold) !important;\n  opacity: var(--opacity-muted) !important;\n}\n.back { grid-area: back; justify-self: start; }\n.home { grid-area: home; justify-self: end; }\n.up { grid-area: up; }\n.left { grid-area: left; }\n.ok { grid-area: ok; }\n.right { grid-area: right; }\n.down { grid-area: down; }",
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "name": "Back",
                            "css_class": "back",
                            "icon": "mdi:arrow-left",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "back"
                              }
                            }
                          },
                          {
                            "name": "Home",
                            "css_class": "home",
                            "icon": "mdi:home",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "home"
                              }
                            }
                          },
                          {
                            "name": "Up",
                            "css_class": "up",
                            "icon": "mdi:chevron-up",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "up"
                              }
                            }
                          },
                          {
                            "name": "Left",
                            "css_class": "left",
                            "icon": "mdi:chevron-left",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "left"
                              }
                            }
                          },
                          {
                            "name": "OK",
                            "css_class": "ok",
                            "show_name": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "ok"
                              }
                            }
                          },
                          {
                            "name": "Right",
                            "css_class": "right",
                            "icon": "mdi:chevron-right",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "right"
                              }
                            }
                          },
                          {
                            "name": "Down",
                            "css_class": "down",
                            "icon": "mdi:chevron-down",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.origami_tv_key",
                              "data": {
                                "tv": "media_player.universal_hotbox_top_chromecast",
                                "key": "down"
                              }
                            }
                          }
                        ]
