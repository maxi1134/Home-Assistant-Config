            },
            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#lights",
              "button_type": "name",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "button",
                      "button_type": "state",
                      "entity": "light.group_all_inside_lights",
                      "name": "{%- set lamps = expand('light.group_all_inside_lights') -%} {%- set n = lamps | selectattr('state', 'eq', 'on') | list | count -%} {{ 'Lights off' if n == 0 else n ~ ' of ' ~ lamps | count ~ ' on' }}",
                      "show_icon": false,
                      "state_content": "{%- set t = states.light.group_all_inside_lights.last_changed | as_local -%} {{ 'since ' ~ t.strftime('%H:%M' if t.date() == now().date() else '%b %-d') }}",
                      "modules": [
                        "origami_base"
                      ],
                      "origami_base": {
                        "large": true
                      },
                      "button_action": {
                        "tap_action": {
                          "action": "none"
                        }
                      },
                      "rows": "auto",
                      "sub_button": {
                        "bottom_layout": "rows",
                        "main": [
                          {
                            "icon": "mdi:power",
                            "show_background": true,
                            "tap_action": {
                              "action": "toggle"
                            }
                          }
                        ],
                        "bottom": [
                          {
                            "name": "All lamps",
                            "group": [
                              {
                                "sub_button_type": "slider",
                                "always_visible": true
                              },
                              {
                                "icon": "mdi:chevron-down",
                                "fill_width": false,
                                "show_background": true,
                                "tap_action": {
                                  "action": "fire-dom-event",
                                  "mini_popup": "lamps"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Looks",
                      "modules": [
                        "origami_header"
                      ]
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "sub-buttons",
                      "modules": [
