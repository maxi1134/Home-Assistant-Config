-grey-color:#564C6E;--blue-grey-color:#8F97B8;--tint-strength:12%;--fill-strength:35%;--shadow-tint:10, 4, 20;--shadow-edge:inset 0 0.5px 0 rgba(255, 255, 255, 0.07), 0 0 0 0.5px rgba(var(--shadow-tint), 0.35);--card-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 6px 14px -6px rgba(var(--shadow-tint), 0.5);--chip-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 3px 7px -3px rgba(var(--shadow-tint), 0.45);--card-shadow-color:rgba(var(--shadow-tint), 0.65);--shadow-elevated:var(--shadow-edge), 0 2px 6px -2px rgba(var(--shadow-tint), 0.5), 0 20px 48px -12px rgba(var(--shadow-tint), 0.7);--shadow-sheet:var(--shadow-edge), 0 -1px 3px rgba(var(--shadow-tint), 0.25), 0 -4px 12px rgba(var(--shadow-tint), 0.25), 0 -12px 32px rgba(var(--shadow-tint), 0.35);--navbar-shadow:0px -1px 2px rgba(var(--shadow-tint), 0.3), 0px -10px 28px -8px rgba(var(--shadow-tint), 0.55);--ha-color-fill-primary-loud-hover:color-mix(in srgb, var(--accent-color) 90%, #000000 10%);--ha-color-fill-primary-loud-active:color-mix(in srgb, var(--accent-color) 80%, #000000 20%);--rgb-secondary-text-color:179, 172, 192;--rgb-card-background-color:52, 41, 79;--rgb-error-color:254, 68, 80;--rgb-warning-color:255, 139, 57;--rgb-success-color:114, 241, 184;--rgb-info-color:249, 42, 173;--ha-color-primary-05:#1A0412;--ha-color-primary-10:#2E0720;--ha-color-primary-20:#520C39;--ha-color-primary-30:#7A1255;--ha-color-primary-40:#A31871;--ha-color-primary-50:#D0208F;--ha-color-primary-60:#F92AAD;--ha-color-primary-70:#FB62C2;--ha-color-primary-80:#FC95D6;--ha-color-primary-90:#FEC8EA;--ha-color-primary-95:#FFE4F5;--ha-card-background:#3A2766;--rgb-card-background-color:58,39,102;--popup-background:#24173D;--fill-base:#FF7EDB;--fill-contrast:20%;--fill-strong:color-mix(in srgb,#FF7EDB 28%,transparent);--fill-loud:color-mix(in srgb,#36F9F6 70%,transparent);--toggle-on:#F92AAD;--fill-active:#F92AAD;--text-color-active:#1A0F2E;--tint-strength:24%;--fill-strength:45%;--state-me