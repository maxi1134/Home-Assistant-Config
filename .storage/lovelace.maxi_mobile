                          "media_player.mass_closet_aux2_speaker": "Closet",
                          "media_player.mass_patio_wiim_speaker": "Patio"
                        },
                        "animate": true
                      },
                      "origami_media": {
                        "cover": "${(s => ['playing', 'paused', 'buffering'].includes(hass.states[hass.states[s]?.attributes?.active_child ?? s]?.state) ? 'above' : 'icon')(states('input_select.origami_selected_speaker'))}",
                        "leader": "${(s => ((g, s) => !!g && !['off', 'unavailable', 'unknown'].includes(g.state) && !!g.attributes.active_queue && hass.states[hass.states[s]?.attributes?.active_child ?? s]?.attributes?.active_queue === g.attributes.active_queue)(hass.states['media_player.group_mass_home_group_speakers'], s) ? 'media_player.group_mass_home_group_speakers' : hass.states[s]?.attributes?.group_members?.[0] ?? s)(states('input_select.origami_selected_speaker'))}",
                        "state": "${(p => (src => !p || ['unavailable', 'unknown'].includes(p.state) ? 'Unavailable' : /bluetooth/i.test(src) ? 'Played from a phone' : /optical|coax|hdmi|line|aux|\\btv\\b/i.test(src) ? format(p.entity_id, 'source') : '')(String(p?.attributes?.source ?? '')))(hass.states[(s => hass.states[s]?.attributes?.group_members?.[0] ?? s)(states('input_select.origami_selected_speaker'))])}",
                        "icons": {
                          "bluetooth": "mdi:bluetooth",
                          "tv": "mdi:television",
                          "line": "mdi:audio-input-rca",
                          "idle": "mdi:music-note-off",
                          "on": "mdi:music-note-off",
