{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.maxi_mobile",
  "data": {
    "config": {
      "views": [
        {
          "type": "custom:grid-layout",
          "title": "main_view_new",
          "path": "main-view-new",
          "layout": {
            "width": "95%"
          },
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "color": "state",
                      "show_name": true,
                      "show_icon": true,
                      "show_state": true,
                      "type": "glance",
                      "entities": [
                        {
                          "entity": "sensor.security_all_clear",
                          "name": "Security",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#security_popup"
                          }
                        },
                        {
                          "entity": "weather.weather_montreal_forecast",
                          "name": "Weather",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#weather"
                          }
                        },
                        {
                          "entity": "binary_sensor.motion_inside_home",
                          "icon": "mdi:cctv",
                          "name": "Cameras",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#cameras"
                          }
                        },
                        {
                          "entity": "binary_sensor.motion_inside_home",
                          "name": "Motion All",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#motion-map-page"
                          }
                        },
                        {
                          "entity": "light.group_all_lights",
                          "name": "Lights",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#lights"
                          }
                        },
                        {
                          "entity": "media_player.group_mass_home_group_speakers",
