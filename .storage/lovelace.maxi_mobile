                      "origami_base": {
                        "animate": true
                      },
                      "origami_table": {
                        "columns": [
                          {
                            "name": "room",
                            "icon": "mdi:circle",
                            "color_template": "${(t => [[12, '#728FA8B3'], [15, '#7C97A9B3'], [17, '#8BA2A8B3'], [18.5, '#9AAEA3B3'], [22, '#88A37EB3'], [24, '#99A677B3'], [25, '#AEA76FB3'], [26, '#BB9F68B3'], [27, '#C0935FB3'], [28, '#BF8A5FB3'], [29, '#BB7E5DB3'], [30.5, '#B3735CB3'], [32, '#AA6A5AB3'], [Infinity, '#9C6056B3']] .find(([top]) => t <= top)?.[1] ?? 'transparent') (hass.config.unit_system.temperature === '°F' ? (state - 32) / 1.8 : parseFloat(state))}"
                          },
                          {
                            "name": "thermostat",
                            "icon": "mdi:thermostat",
                            "text_template": "${num(attr.temperature)}°"
                          },
                          {
                            "name": "temperature",
                            "width": "1fr",
                            "align": "end",
                            "icon": "mdi:thermometer",
                            "text_template": "${num(state, 0)}°",
                            "icon_template": "${(t => +state === Math.max(...t) && +state > Math.min(...t) ? 'mdi:arrow-up' : +state === Math.min(...t) && +state < Math.max(...t) ? 'mdi:arrow-down' : '')( ['sensor.sensor_salon_temperature_temperature', 'sensor.sensor_kitchen_temperature_temperature', 'sensor.sensor_workshop_temperature_temperature', 'sensor.sensor_bedroom_temperature_temperature', 'sensor.sensor_bathroom_temperature_temperature', 'sensor.sensor_hotbox_down_temperature_temperature', 'sensor.sensor_server_temperature_temperature'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}",
                            "color_template": "${(t => +state === Math.min(...t) && +state < Math.max(...t) ? 'var(--secondary-text-color)' : '')( ['sensor.sensor_salon_temperature_temperature', 'sensor.sensor_kitchen_temperature_temperature', 'sensor.sensor_workshop_temperature_temperature', 'sensor.sensor_bedroom_temperature_temperature', 'sensor.sensor_bathroom_temperature_temperature', 'sensor.sensor_hotbox_down_temperature_temperature', 'sensor.sensor_server_temperature_temperature'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}",
                            "on": "${(t => +state === Math.max(...t) && +state > Math.min(...t))( ['sensor.sensor_salon_temperature_temperature', 'sensor.sensor_kitchen_temperature_temperature', 'sensor.sensor_workshop_temperature_temperature', 'sensor.sensor_bedroom_temperature_temperature', 'sensor.sensor_bathroom_temperature_temperature', 'sensor.sensor_hotbox_down_temperature_temperature', 'sensor.sensor_server_temperature_temperature'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}"
                          },
                          {
                            "name": "humidity",
                            "icon": "mdi:water-percent",
                            "text_template": "${num(state, 0, '%')}",
                            "icon_template": "${(t => +state === Math.max(...t) && +state > Math.min(...t) ? 'mdi:arrow-up' : +state === Math.min(...t) && +state < Math.max(...t) ? 'mdi:arrow-down' : '')( ['sensor.sensor_salon_temperature_humidity', 'sensor.sensor_kitchen_temperature_humidity', 'sensor.sensor_workshop_temperature_humidity', 'sensor.sensor_bedroom_temperature_humidity', 'sensor.sensor_bathroom_temperature_humidity', 'sensor.sensor_hotbox_down_temperature_humidity', 'sensor.sensor_server_temperature_humidity'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}",
                            "color_template": "${(t => +state === Math.min(...t) && +state < Math.max(...t) ? 'var(--secondary-text-color)' : '')( ['sensor.sensor_salon_temperature_humidity', 'sensor.sensor_kitchen_temperature_humidity', 'sensor.sensor_workshop_temperature_humidity', 'sensor.sensor_bedroom_temperature_humidity', 'sensor.sensor_bathroom_temperature_humidity', 'sensor.sensor_hotbox_down_temperature_humidity', 'sensor.sensor_server_temperature_humidity'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}",
                            "on": "${(t => +state === Math.max(...t) && +state > Math.min(...t))( ['sensor.sensor_salon_temperature_humidity', 'sensor.sensor_kitchen_temperature_humidity', 'sensor.sensor_workshop_temperature_humidity', 'sensor.sensor_bedroom_temperature_humidity', 'sensor.sensor_bathroom_temperature_humidity', 'sensor.sensor_hotbox_down_temperature_humidity', 'sensor.sensor_server_temperature_humidity'] .map((id) => parseFloat(states(id))).filter((v) => !isNaN(v)))}"
                          }
                        ]
                      },
