                                "name": "Everywhere",
                                "sub_button_type": "slider",
                                "always_visible": true,
                                "slider_live_update": false
                              }
                            ]
                          },
                          {
                            "name": "Salon",
                            "buttons_layout": "inline",
                            "justify_content": "start",
                            "group": [
                              {
                                "icon": "mdi:volume-high",
                                "show_icon": true,
                                "show_name": false,
                                "show_state": false,
                                "show_background": true,
                                "origami_base": {
                                  "icon": "${hass.states['media_player.mass_salon_wiim_speaker']?.attributes?.is_volume_muted ? 'mdi:volume-off' : 'mdi:volume-high'}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.origami_toggle_mute",
                                  "data": {
                                    "player": "media_player.mass_salon_wiim_speaker"
                                  }
                                }
                              },
                              {
                                "name": "Salon",
                                "show_name": true,
                                "show_icon": false,
                                "show_state": false,
                                "show_background": false,
                                "tap_action": {
