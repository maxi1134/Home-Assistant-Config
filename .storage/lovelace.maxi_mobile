                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "${((h, g) => !!h && !['off', 'unavailable', 'unknown'].includes(h.state) && g.length > 1 && (h.attributes.group_members ?? []).length === g.length && g.every(x => (h.attributes.group_members ?? []).includes(x)))(hass.states['media_player.group_mass_home_group_speakers'], (e => hass.states[e]?.attributes?.group_members ?? [])('media_player.mass_salon_wiim_speaker')) ? 'Home Group' : 'Salon group'}",
                      "modules": [
                        "origami_header"
                      ],
                      "origami_base": {
                        "hidden": "${!(states('input_select.origami_selected_speaker') === 'media_player.universal_following_media') || !((e => hass.states[e]?.attributes?.group_members ?? [])('media_player.mass_salon_wiim_speaker').length > 1 && (e => hass.states[e]?.attributes?.group_members ?? [])('media_player.mass_salon_wiim_speaker')[0] === 'media_player.mass_salon_wiim_speaker')}"
                      },
