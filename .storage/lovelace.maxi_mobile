                      ],
                      "start_card": "{% set rooms = {\n    'entrance': '1',\n    'salon':    '2',\n    'lounge':   '3',\n    'closet':   '4',\n    'hallway':  '5',\n    'workshop': '6',\n    'bedroom':  '7',\n    'bathroom': '8',\n    'kitchen':  '9',\n    'hotbox':   '10',\n    'server':   '11',\n    'patio':    '12'\n} %}  {# Map current room -> swipe page. Sensor state is lowercased defensively; unknown/unavailable falls through to the all inside page. #}\n{{ rooms.get(states('sensor.maxi_location_by_petro_v2') | lower, '13') }}\n",
                      "parameters": {
                        "autoHeight": true
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
