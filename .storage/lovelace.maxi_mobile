                  "chart_type": "donut",
                  "header": {
                    "show": true,
                    "title": "Today by category"
                  },
                  "apex_config": {
                    "legend": {
                      "position": "bottom"
                    },
                    "dataLabels": {
                      "formatter": "EVAL:function(val, opts) {\n  const h = opts.w.config.series[opts.seriesIndex];\n  return h < 0.25 ? '' : h.toFixed(1) + 'h';\n}\n"
                    }
                  },
                  "series": [
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Away",
                      "color": "#26a69a",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.away)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Desk",
                      "color": "#42a5f5",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.desk)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Media",
                      "color": "#ab47bc",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.media)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Personal",
                      "color": "#ec407a",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.personal)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Chores",
                      "color": "#66bb6a",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.chores)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Social",
                      "color": "#ffa726",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.social)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Phone",
                      "color": "#ef5350",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.phone)]];\n"
                    },
                    {
                      "entity": "sensor.maxi_activity_durations",
                      "name": "Idle",
                      "color": "#78909c",
                      "data_generator": "return [[end.getTime(), Number(entity.attributes.idle)]];\n"
                    }
                  ]
                }
              ]
            },
            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#media-players",
              "name": "",
              "button_type": "name",
              "show_header": true,
              "show_icon": false,
              "scrolling_effect": false,
              "margin": "7px",
              "margin_top_mobile": "0px",
              "margin_top_desktop": "20%",
              "popup_mode": "fit-content",
              "with_bottom_offset": true,
              "modules": [
                "origami_base",
                "origami_popup"
              ],
              "origami_base": {
                "animate": true,
                "words": {
                  "media_player.universal_following_media": "Following",
                  "media_player.mass_salon_wiim_speaker": "Salon",
                  "media_player.mass_lounge_wiim_speaker": "Lounge",
                  "media_player.mass_hallway_wiim_speaker": "Hallway",
                  "media_player.mass_workshop_wiim_speaker": "Workshop",
                  "media_player.mass_bedroom_vpe_speaker": "Bedroom",
                  "media_player.mass_kitchen_wiim_speaker": "Kitchen",
                  "media_player.mass_hotbox_wiim_speaker": "Hotbox",
                  "media_player.mass_bathroom_vpe_speaker": "Bathroom",
                  "media_player.mass_closet_aux2_speaker": "Closet",
                  "media_player.mass_patio_wiim_speaker": "Patio"
                }
              },
              "origami_popup": {
                "gap": "var(--ha-space-4)",
                "art": "${states('input_select.origami_selected_speaker')}",
                "value_style": "chip",
                "value_position": "beside",
                "mini_popups": {
                  "group": {
                    "width": "256px",
                    "cards": [
                      {
                        "type": "custom:bubble-card",
                        "card_type": "separator",
                        "name": "${name(states('input_select.origami_selected_speaker'))}",
                        "modules": [
                          "origami_header"
                        ],
                        "origami_header": {
                          "weight": "medium",
                          "value_size": "var(--ha-font-size-s)"
                        },
                        "sub_button": {
                          "main": [
                            {
                              "name": "Ungroup",
                              "icon": "mdi:link-variant-off",
                              "show_name": true,
                              "origami_header": {
                                "icon": "${states('script.origami_group_speakers') === 'on' ? 'mdi:timer-sand' : ''}",
                                "disabled": "${states('script.origami_group_speakers') === 'on'}",
                                "hidden": "${(hass.states[states('input_select.origami_selected_speaker')]?.attributes?.group_members?.length ?? 0) < 2 || ((g, s) => !!g && !['off', 'unavailable', 'unknown'].includes(g.state) && !!g.attributes.active_queue && hass.states[hass.states[s]?.attributes?.active_child ?? s]?.attributes?.active_queue === g.attributes.active_queue)(hass.states['media_player.group_mass_home_group_speakers'], states('input_select.origami_selected_speaker'))}"
                              },
                              "tap_action": {
                                "action": "perform-action",
                                "perform_action": "script.origami_group_speakers",
                                "data": {
                                  "speaker": "input_select.origami_selected_speaker",
                                  "ungroup": true
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "type": "custom:bubble-card",
                        "card_type": "sub-buttons",
                        "modules": [
                          "origami_button"
                        ],
                        "origami_base": {
                          "hidden": "${(group => (hass.states['input_select.origami_selected_speaker']?.attributes?.options ?? []).every((s) => group.includes(s) || ['playing', 'buffering', 'unavailable', 'unknown'].includes(states(s)) || /bluetooth|optical|coax|hdmi|line|aux/i.test(hass.states[s]?.attributes?.source ?? '')))((sel => hass.states[sel]?.attributes?.group_members?.length ? hass.states[sel].attributes.group_members : [sel])(states('input_select.origami_selected_speaker')))}"
                        },
                        "origami_button": {
                          "columns": 1,
                          "align": "center",
                          "icon_size": "var(--icon-size-xs)",
                          "padding": "0 0 var(--ha-space-2) 0"
                        },
                        "sub_button": {
                          "main": [],
                          "bottom": [
                            {
                              "name": "Group all",
                              "icon": "mdi:link-variant",
                              "show_name": true,
                              "tap_action": {
                                "action": "perform-action",
                                "perform_action": "script.origami_group_speakers",
                                "data": {
                                  "speaker": "input_select.origami_selected_speaker",
                                  "all": true
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "type": "custom:bubble-card",
                        "card_type": "sub-buttons",
                        "modules": [
                          "origami_tiles"
                        ],
                        "origami_base": {
                          "sub_button_height": "44px"
                        },
                        "origami_tiles": {
                          "layout": "list",
                          "slim": true,
                          "dividers": true,
                          "sign": "add",
                          "background": false,
                          "pending": true
                        },
                        "sub_button": {
                          "main": [],
                          "bottom": [
                            {
                              "entity": "media_player.mass_salon_wiim_speaker",
                              "name": "Salon",
                              "show_icon": false,
                              "origami_tiles": {
                                "on": "${(hass.states[states('input_select.origami_selected_speaker')]?.attributes?.group_members ?? []).includes(entity)}"
                              },
                              "visibility": [
                                {
                                  "condition": "state",
                                  "entity": "input_select.origami_selected_speaker",
                                  "state_not": "media_player.mass_salon_wiim_speaker"
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.mass_salon_wiim_speaker",
                                  "state_not": [
                                    "unavailable",
                                    "unknown"
                                  ]
                                }
                              ],
                              "tap_action": {
                                "action": "perform-action",
                                "perform_action": "script.origami_group_speakers",
                                "data": {
                                  "speaker": "input_select.origami_selected_speaker",
                                  "member": "media_player.mass_salon_wiim_speaker"
                                }
                              }
                            },
                            {
                              "entity": "media_player.mass_lounge_wiim_speaker",
                              "name": "Lounge",
                              "show_icon": false,
                              "origami_tiles": {
                                "on": "${(hass.states[states('input_select.origami_selected_speaker')]?.attributes?.group_members ?? []).includes(entity)}"
                              },
                              "visibility": [
