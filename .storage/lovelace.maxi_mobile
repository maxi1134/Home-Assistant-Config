                    "icon": "mdi:circle",
                    "show_name": false,
                    "show_background": true,
                    "origami_popup": {
                      "name": "${(g => g && !['off', 'unavailable', 'unknown'].includes(g.state) && attr.active_queue && attr.active_queue === g.attributes.active_queue ? 'Home Group' : ((attr.group_members?.length ?? 0) > 1 ? 'Group · ' : '') + name(entity))(hass.states['media_player.group_mass_home_group_speakers'])}",
                      "color": "var(--media-color)",
                      "hidden": "${(() => { const lead = (x) => hass.states[x]?.attributes?.group_members?.[0] ?? x; const mine = lead(states('input_select.origami_selected_speaker')); return ['media_player.mass_salon_wiim_speaker', 'media_player.mass_lounge_wiim_speaker', 'media_player.mass_hallway_wiim_speaker', 'media_player.mass_workshop_wiim_speaker', 'media_player.mass_bedroom_vpe_speaker', 'media_player.mass_kitchen_wiim_speaker', 'media_player.mass_hotbox_wiim_speaker', 'media_player.mass_bathroom_vpe_speaker', 'media_player.mass_closet_aux2_speaker', 'media_player.mass_patio_wiim_speaker'].find((s) => s !== mine && lead(s) === s && states(s) === 'playing'); })() !== entity}"
                    },
                    "tap_action": {
                      "action": "perform-action",
                      "perform_action": "input_select.select_option",
                      "target": {
                        "entity_id": "input_select.origami_selected_speaker"
                      },
                      "data": {
                        "option": "media_player.mass_salon_wiim_speaker"
                      }
                    }
