                              "webrtc"
                            ],
                            "url": "http://192.168.0.11:1984",
                            "stream": "parking_camera_sub"
                          },
                          "camera_entity": "camera.parking_camera",
                          "webrtc_card": {
                            "entity": "camera.parking_camera"
                          },
                          "always_error_if_entity_unavailable": false
                        },
                        {
                          "live_provider": "go2rtc",
                          "go2rtc": {
                            "modes": [
                              "webrtc"
                            ],
                            "url": "http://192.168.0.11:1984",
                            "stream": "back_yard_camera_sub"
                          },
                          "camera_entity": "camera.back_yard_camera",
                          "webrtc_card": {
                            "entity": "camera.back_yard_camera"
                          },
                          "always_error_if_entity_unavailable": false
                        }
                      ],
                      "view": {
                        "default": "live",
                        "camera_select": "clips",
                        "interaction_seconds": 60,
                        "triggers": {
                          "actions": {
                            "trigger": "live"
                          },
                          "filter_selected_camera": false
                        },
                        "dim": true
                      },
                      "dimensions": {
                        "aspect_ratio_mode": "unconstrained"
                      },
                      "media_gallery": {
                        "controls": {
                          "thumbnails": {
                            "size": 175
                          }
                        }
                      },
                      "cameras_global": {
                        "jsmpeg": {
                          "options": {
                            "disableWebAssembly": true
                          }
                        }
                      },
                      "performance": {
                        "features": {
                          "media_chunk_size": 26,
                          "animated_progress_indicator": false
                        }
                      }
                    }
                  ]
                }
              ],
              "show_header": true,
              "show_icon": false,
              "scrolling_effect": false,
              "margin": "7px",
              "margin_top_mobile": "0px",
              "margin_top_desktop": "20%",
              "popup_mode": "fit-content",
              "with_bottom_offset": true,
              "name": "Cameras",
              "modules": [
                "origami_base",
                "origami_popup"
              ],
              "origami_base": {
                "animate": true
              },
              "origami_popup": {
                "gap": "var(--ha-space-4)",
                "value_style": "chip",
                "value_position": "beside"
              },
              "styles": ".bubble-pop-up { --ha-space-1:4px;--ha-space-2:8px;--ha-space-3:12px;--ha-space-4:16px;--ha-space-5:20px;--ha-card-border-radius:22px;--radius-ratio:0.35;--radius-inner:calc(var(--tile-size) * var(--radius-ratio));--radius-control:calc(var(--control-height-icon) * var(--radius-ratio));--radius-small:calc(var(--control-height-mini) * var(--radius-ratio));--radius-circle:var(--ha-border-radius-circle, 50%);--border-width:0;--border-color:color-mix(in srgb, var(--primary-text-color) var(--border-contrast), transparent);--card-ring:inset 0 0 0 var(--border-width) var(--border-color);--card-elevation:var(--card-shadow), var(--card-ring);--toggle-on:color-mix(in srgb, var(--primary-text-color) 85%, var(--ha-card-background));--fill-subtle:color-mix(in srgb, var(--fill-base) var(--fill-contrast), transparent);--fill-strong:color-mix(in srgb, var(--fill-base) 12%, transparent);--fill-loud:color-mix(in srgb, var(--fill-base) 30%, transparent);--fill-active:var(--toggle-on);--accent-color-background:color-mix(in srgb, var(--ok-color) var(--tint-strength), var(--ha-card-background));--tile-background:var(--fill-subtle);--tile-chip-shadow:var(--chip-shadow);--opacity-disabled:.3;--opacity-quiet:.45;--opacity-muted:.6;--opacity-strong:.8;--control-height-mini:var(--ha-space-8, 32px);--control-height-icon:var(--ha-space-10, 40px);--control-height-row:var(--ha-space-11, 44px);--control-height-list:var(--ha-space-12, 48px);--control-height-sm:var(--ha-space-13, 52px);--control-height:var(--ha-space-14, 56px);--control-height-lg:var(--ha-space-16, 64px);--tile-size:var(--ha-space-12, 48px);--tile-size-lg:var(--ha-space-20, 80px);--dot-size:12px;--icon-size-2xs:14px;--icon-size-xs:18px;--icon-size-s:var(--ha-space-5, 20px);--icon-size-m:var(--ha-space-6, 24px);--icon-size-l:var(--ha-space-7, 28px);--ha-font-size-xl:22px;--ha-font-size-l:18px;--ha-font-size-m:16px;--ha-font-size-s:14px;--ha-font-size-xs:14px;--primary-font-family:'Montserrat', sans-serif;--ha-font-family-body:var(--primary-font-family);--ha-font-family-code:var(--primary-font-family);--mdc-typography-font-family:var(--primary-font-family);--ha-font-weight-normal:500;--ha-font-weight-medium:500;--ha-font-weight-bold:700;--ha-line-height-condensed:1.1;--ha-line-height-normal:1.3;--ha-line-height-expanded:1.6;--duration-fast:var(--ha-animation-duration-fast, 150ms);--duration-normal:var(--ha-animation-duration-normal, 250ms);--duration-slow:var(--ha-animation-duration-slow, 350ms);--ease-standard:cubic-bezier(.22, 1, .36, 1);--transition-interactive:background-color var(--duration-normal) ease, color var(--duration-normal) ease, box-shadow var(--duration-normal) ease;--press-scale:0.96;--blur-soft:blur(12px);--blur-strong:blur(18px);--track-height:10px;--track-color:var(--fill-strong);--scroller-bleed:var(--view-bleed);--scroller-padding:var(--scroller-bleed) var(--scroller-bleed) var(--ha-space-10, 40px);--card-background-color:var(--ha-card-background);--ha-card-border-width:0px;--ha-card-border-color:var(--border-color);--ha-card-box-shadow:var(--card-elevation);--ha-badge-border-radius:calc(var(--ha-badge-size, 36px) * var(--radius-ratio));--card-item-background:var(--fill-subtle);--ha-color-form-background:var(--fill-subtle);--outline-color:var(--border-color);--text-color-active:var(--ha-card-background);--text-primary-color:var(--text-color-active);--ha-color-text-secondary:var(--secondary-text-color);--disabled-color:var(--disabled-text-color);--state-icon-color:var(--primary-text-color);--state-active-color:var(--green-color);--state-switch-active-color:var(--state-active-color);--state-binary_sensor-active-color:var(--state-active-color);--state-binary_sensor-window-on-color:var(--cyan-color);--state-binary_sensor-door-on-color:var(--cyan-color);--state-media_player-paused-color:var(--secondary-text-color);--state-cover-closed-color:var(--accent-color);--state-person-not_home-color:var(--secondary-text-color);--state-alarm_control_panel-disarmed-color:var(--accent-color);--success-color:var(--green-color);--warning-color:var(--orange-color);--error-color:var(--red-color);--tint:color-mix(in srgb, currentColor var(--tint-strength), var(--ha-card-background));--lamp-color:var(--state-light-active-color);--heat-color:var(--state-climate-heat-color);--water-color:var(--state-climate-cool-color);--media-color:var(--state-media_player-active-color);--ok-color:var(--success-color);--control-switch-on-color:var(--toggle-on);--control-switch-off-color:var(--grey-color);--wa-color-on-normal:var(--primary-text-color);--ha-ripple-color:var(--card-item-background);--ha-ripple-hover-color:var(--accent-color-background);--ha-ripple-pressed-color:var(--accent-color-background);--ha-ripple-hover-opacity:0.1;--ha-ripple-pressed-opacity:0.2;--input-ink-color:var(--primary-text-color);--input-label-ink-color:var(--primary-text-color);--input-fill-color:var(--fill-subtle);--input-idle-line-color:var(--background-color);--input-hover-line-color:var(--primary-color);--input-disabled-line-color:var(--fill-subtle);--input-dropdown-icon-color:var(--secondary-text-color);--input-disabled-fill-color:var(--background-color);--input-disabled-ink-color:var(--disabled-text-color);--mdc-text-field-label-ink-color:var(--secondary-text-color);--mdc-theme-surface:var(--ha-card-background);--mdc-theme-on-secondary:var(--text-color-active);--ha-heading-card-title-font-weight:var(--ha-font-weight-bold);--ha-color-fill-primary-quiet-resting:var(--ha-card-background);--button-color-fill-normal-hover:color-mix(in srgb, var(--accent-color) 26%, var(--ha-card-background) 74%);--button-color-fill-normal-active:color-mix(in srgb, var(--accent-color) 34%, var(--background-color) 66%);--info-color:var(--accent-color);--bubble-main-background-color:var(--ha-card-background);--bubble-secondary-background-color:var(--card-item-background);--bubble-icon-background-color:var(--card-item-background);--bubble-pop-up-main-background-color:var(--popup-background);--bubble-backdrop-background-color:var(--backdrop-background-color);--bubble-border-radius:var(--ha-card-border-radius);--bubble-accent-color:var(--accent-color);--bubble-light-color:color-mix(in srgb, var(--lamp-color) var(--fill-strength), var(--ha-card-background));--bubble-line-background-color:var(--secondary-text-color);--bubble-sub-button-light-background-color:var(--accent-color-background);--bubble-select-list-background-color:var(--ha-card-background);--bubble-select-main-background-color:var(--ha-card-background);--bubble-select-list-width:140px;--bubble-select-list-item-accent-color:var(--fill-subtle);--card-padding:var(--ha-space-3, 12px);--control-padding-x:var(--ha-space-4, 16px);--font-size-headline:var(--ha-font-size-3xl, 28px);--font-size-compact:var(--ha-font-size-s);--lamp-tint:color-mix(in srgb, var(--lamp-color) var(--tint-strength), var(--ha-card-background));--scroller-mask:linear-gradient(to right, transparent 0px, black var(--scroller-bleed), black calc(100% - var(--ha-space-12, 48px)), transparent 100%);--border-contrast:8%;--background-color:#241B2F;--dashboard-background:#241B2F;--ha-card-background:#34294F;--popup-background:#2A2139;--tile-chip-background:var(--fill-strong);--primary-text-color:#FFFFFF;--secondary-text-color:color-mix(in srgb, var(--primary-text-color) 70%, transparent);--fill-base:#E9DDFF;--fill-contrast:6%;--icon-color:#B4A6D6;--disabled-text-color:#6B5F86;--primary-color:#F92AAD;--accent-color:#F92AAD;--dark-primary-color:#B81F80;--light-primary-color:var(--ha-card-background);--amber-color:#FFCC00;--orange-color:#FF8B39;--deep-orange-color:#F97E72;--red-color:#FE4450;--pink-color:#FF7EDB;--purple-color:#C792EA;--deep-purple-color:#9D7CD8;--indigo-color:#848BBD;--blue-color:#6E9CFF;--light-blue-color:#72C8FF;--cyan-color:#36F9F6;--teal-color:#00EEE4;--green-color:#72F1B8;--light-green-color:#A6F18C;--lime-color:#D4F17B;--yellow-color:#FEDE5D;--brown-color:#B3836B;--light-grey-color:#B9B0CC;--grey-color:#8B82A3;--dark-grey-color:#564C6E;--blue-grey-color:#8F97B8;--tint-strength:12%;--fill-strength:35%;--shadow-tint:10, 4, 20;--shadow-edge:inset 0 0.5px 0 rgba(255, 255, 255, 0.07), 0 0 0 0.5px rgba(var(--shadow-tint), 0.35);--card-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 6px 14px -6px rgba(var(--shadow-tint), 0.5);--chip-shadow:var(--shadow-edge), 0 1px 2px rgba(var(--shadow-tint), 0.3), 0 3px 7px -3px rgba(var(--shadow-tint), 0.45);--card-shadow-color:rgba(var(--shadow-tint), 0.65);--shadow-elevated:var(--shadow-edge), 0 2px 6px -2px rgba(var(--shadow-tint), 0.5), 0 20px 48px -12px rgba(var(--shadow-tint), 0.7);--shadow-sheet:var(--shadow-edge), 0 -1px 3px rgba(var(--shadow-tint), 0.25), 0 -4px 12px rgba(var(--shadow-tint), 0.25), 0 -12px 32px rgba(var(--shadow-tint), 0.35);--navbar-shadow:0px -1px 2px rgba(var(--shadow-tint), 0.3), 0px -10px 28px -8px rgba(var(--shadow-tint), 0.55);--ha-color-fill-primary-loud-hover:color-mix(in srgb, var(--accent-color) 90%, #000000 10%);--ha-color-fill-primary-loud-active:color-mix(in srgb, var(--accent-color) 80%, #000000 20%);--rgb-secondary-text-color:179, 172, 192;--rgb-card-background-color:52, 41, 79;--rgb-error-color:254, 68, 80;--rgb-warning-color:255, 139, 57;--rgb-success-color:114, 241, 184;--rgb-info-color:249, 42, 173;--ha-color-primary-05:#1A0412;--ha-color-primary-10:#2E0720;--ha-color-primary-20:#520C39;--ha-color-primary-30:#7A1255;--ha-color-primary-40:#A31871;--ha-color-primary-50:#D0208F;--ha-color-primary-60:#F92AAD;--ha-color-primary-70:#FB62C2;--ha-color-primary-80:#FC95D6;--ha-color-primary-90:#FEC8EA;--ha-color-primary-95:#FFE4F5;--ha-card-background:#3A2766;--rgb-card-background-color:58,39,102;--popup-background:#24173D;--fill-base:#FF7EDB;--fill-contrast:20%;--fill-strong:color-mix(in srgb,#FF7EDB 28%,transparent);--fill-loud:color-mix(in srgb,#36F9F6 70%,transparent);--toggle-on:#F92AAD;--fill-active:#F92AAD;--text-color-active:#1A0F2E;--tint-strength:24%;--fill-strength:45%;--state-media_player-active-color:#36F9F6;--media-color:#36F9F6;--accent-color:#F92AAD;--primary-color:#F92AAD;--track-color:color-mix(in srgb,#36F9F6 22%,transparent);--icon-color:#36F9F6;--secondary-text-color:#C9B6F2;--tile-chip-background:color-mix(in srgb,#F92AAD 18%,#3A2766);--chip-shadow:0 0 0 0.5px rgba(249,42,173,.35),0 2px 10px -2px rgba(249,42,173,.45);--card-shadow:inset 0 0.5px 0 rgba(255,255,255,.08),0 0 0 0.5px rgba(54,249,246,.25),0 6px 18px -6px rgba(249,42,173,.45) }\n"
            },
            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#weather",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:origami-weather",
                      "weather_entity": "weather.weather_montreal_forecast",
                      "color_mode": "theme",
                      "card_height": "150px",
                      "card_padding": "0px 0px 0px 0px",
                      "card_offset": "20px 0px 0px 0px",
                      "card_tap_action": {
                        "action": "more-info"
                      },
                      "sun_moon_size": 40,
                      "sun_moon_x": "dynamic",
                      "shadow_color": "var(--tile-chip-shadow)",
                      "cloud_effects": false,
                      "background_mode": "images",
                      "weather_image_path": "https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/",
                      "weather_image_path_dark": "https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/",
                      "grid_options": {
                        "columns": "full",
                        "rows": "auto"
                      },
                      "content_direction": "row",
                      "content_align": "end",
                      "css": "/* Origami Weather with the Origami theme's values */\n:host {\n  --origami-text-light: var(--primary-text-color);\n  --origami-text-dark: var(--primary-text-color);\n  --origami-bottom-font-weight: var(--ha-font-weight-normal);\n  --origami-bottom-bg-filter: var(--blur-soft);\n  /* A chip's corner is 35 % of its height: the text and 6px above and below it */\n  --origami-bottom-bg-radius: calc((1em + 12px) * var(--radius-ratio));\n}\n/* The pictures have a clear sky, and the card paints the paper in the weather's color. Each picture is also the mask of the sky,\n   so the sun, the moon and the stars show only in the open sky and set behind the hills, the trees and the clouds. */\n#card-root { --paper: #e2e5e7; --sky: none; }\n#card-root.scheme-dark { --paper: #1b1e20; }\n#card-root.weather-sunny { --paper: #eee5d7; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/sunny.webp\"); }\n#card-root.scheme-dark.weather-sunny { --paper: #261d13; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/sunny.webp\"); }\n#card-root.weather-partlycloudy { --paper: #dee9ef; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/partlycloudy.webp\"); }\n#card-root.scheme-dark.weather-partlycloudy { --paper: #182227; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/partlycloudy.webp\"); }\n#card-root.weather-cloudy { --paper: #e2e5e7; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/cloudy.webp\"); }\n#card-root.scheme-dark.weather-cloudy { --paper: #1b1e20; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/cloudy.webp\"); }\n#card-root.weather-fog { --paper: #e8e7e5; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/fog.webp\"); }\n#card-root.scheme-dark.weather-fog { --paper: #222120; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/fog.webp\"); }\n#card-root.weather-rainy { --paper: #d9e1ea; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/rainy.webp\"); }\n#card-root.scheme-dark.weather-rainy { --paper: #171e26; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/rainy.webp\"); }\n#card-root.weather-pouring { --paper: #d7dde4; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/pouring.webp\"); }\n#card-root.scheme-dark.weather-pouring { --paper: #151b21; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/pouring.webp\"); }\n#card-root.weather-lightning { --paper: #e5dfe8; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/lightning.webp\"); }\n#card-root.scheme-dark.weather-lightning { --paper: #221d25; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/lightning.webp\"); }\n#card-root.weather-lightning-rainy { --paper: #dfdbe2; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/lightning-rainy.webp\"); }\n#card-root.scheme-dark.weather-lightning-rainy { --paper: #1d1920; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/lightning-rainy.webp\"); }\n#card-root.weather-hail { --paper: #d3dfdf; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/hail.webp\"); }\n#card-root.scheme-dark.weather-hail { --paper: #121c1c; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/hail.webp\"); }\n#card-root.weather-snowy { --paper: #e5eaec; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/snowy.webp\"); }\n#card-root.scheme-dark.weather-snowy { --paper: #1c2426; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/snowy.webp\"); }\n#card-root.weather-snowy-rainy { --paper: #dde2e5; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/snowy-rainy.webp\"); }\n#card-root.scheme-dark.weather-snowy-rainy { --paper: #1e2124; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/snowy-rainy.webp\"); }\n#card-root.weather-windy { --paper: #dce6e3; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/windy.webp\"); }\n#card-root.scheme-dark.weather-windy { --paper: #182220; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/windy.webp\"); }\n#card-root.weather-windy-variant { --paper: #dae1de; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/windy-variant.webp\"); }\n#card-root.scheme-dark.weather-windy-variant { --paper: #171d1b; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/windy-variant.webp\"); }\n#card-root.weather-clear-night { --paper: #e0e3ed; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/clear-night.webp\"); }\n#card-root.scheme-dark.weather-clear-night { --paper: #161924; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/clear-night.webp\"); }\n#card-root.weather-exceptional { --paper: #eadad3; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/light/exceptional.webp\"); }\n#card-root.scheme-dark.weather-exceptional { --paper: #271a15; --sky: url(\"https://cdn.jsdelivr.net/gh/hazymorning/origami@main/dashboard/weather/diorama/dark/exceptional.webp\"); }\n#card-root.scheme-light, #card-root.scheme-dark { background-color: var(--paper); }\n/* The landscape stands at the bottom left, however wide the card is */\n#weather-bg > img { object-position: left bottom; }\n#card-root.has-weather-bg :is(#sun-moon-layer, #star-canvas) {\n  -webkit-mask-image: var(--sky), linear-gradient(#000 0 0);\n  -webkit-mask-position: left bottom, 0 0;\n  -webkit-mask-size: cover, 100% 100%;\n  -webkit-mask-repeat: no-repeat;\n  -webkit-mask-composite: xor;\n  mask-image: var(--sky), linear-gradient(#000 0 0);\n  mask-position: left bottom, 0 0;\n  mask-size: cover, 100% 100%;\n  mask-repeat: no-repeat;\n  mask-composite: exclude;\n}\n/* The paper changes softly with the weather, and a new picture fades in */\n@media (prefers-reduced-motion: no-preference) {\n  #card-root.scheme-light, #card-root.scheme-dark { transition: background-color 1.2s var(--ease-standard), transform .4s cubic-bezier(.2, 0, .2, 1); }\n  #weather-bg > img { animation: appear .9s var(--ease-standard) both; }\n}\n@keyframes appear { from { opacity: 0; } }\n/* Rain, snow, birds and planes in calmer colors */\n#weather-effects { filter: saturate(.6); }\n/* On a wide screen, the heading above the card sets the space */\n@media (min-width: 768px) { :host { margin: 0px 0px 0px 0px !important; } }\n",
                      "button_containers": [
                        {
                          "position": "custom",
                          "position_anchor": "top-left",
                          "padding": "16px 16px 16px 16px",
                          "button_gap": "6px",
                          "buttons": [
                            {
                              "entity": "sun.sun",
                              "visibility": [
                                {
                                  "condition": "state",
                                  "entity": "sun.sun",
                                  "state": "above_horizon"
                                }
                              ],
                              "elements": [
                                {
                                  "type": "icon",
                                  "icon": "mdi:weather-sunset-down"
                                },
                                {
                                  "type": "text",
                                  "entity": "sun.sun",
                                  "attribute": "next_setting",
                                  "size": "12px",
                                  "weight": "700",
                                  "color": "var(--primary-text-color)"
                                }
                              ]
                            },
                            {
                              "entity": "sun.sun",
                              "visibility": [
                                {
                                  "condition": "state",
                                  "entity": "sun.sun",
                                  "state": "below_horizon"
                                }
                              ],
                              "elements": [
                                {
                                  "type": "icon",
                                  "icon": "mdi:weather-sunset-up"
                                },
                                {
                                  "type": "text",
                                  "entity": "sun.sun",
                                  "attribute": "next_rising",
                                  "size": "12px",
                                  "weight": "700",
                                  "color": "var(--primary-text-color)"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "position": "custom",
                          "position_anchor": "top-right",
                          "align": "end",
                          "padding": "16px 20px 16px 20px",
                          "buttons": [
                            {
                              "entity": "weather.forecast_home",
                              "style": "vertical",
                              "inner_gap": "6px",
                              "padding": "0px 0px 0px 0px",
                              "elements": [
                                {
                                  "type": "text",
                                  "attribute": "temperature",
                                  "precision": 0,
                                  "format": "°",
                                  "size": "40px",
                                  "weight": "700",
                                  "color": "var(--primary-text-color)"
                                },
                                {
                                  "type": "text",
                                  "size": "12px",
                                  "weight": "500"
                                }
                              ]
                            }
                          ]
                        }
                      ]
