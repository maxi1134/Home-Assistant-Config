                      },
                      "sub_button": {
                        "main": [],
                        "bottom": [
                          {
                            "name": "Random",
                            "icon": "mdi:shuffle-variant",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_random_colors",
                              "target": {},
                              "data": {
                                "only_on": false,
                                "saturation": 100,
                                "transition_speed": 1
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_random_colors",
                              "target": {},
                              "data": {
                                "only_on": false,
                                "saturation": 100,
                                "transition_speed": 1
                              }
                            }
                          },
                          {
                            "name": "Pastel",
                            "icon": "mdi:palette-swatch-outline",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_random_pastel_colors",
                              "target": {}
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_random_pastel_colors",
                              "target": {}
                            }
                          },
                          {
                            "name": "Warm",
                            "icon": "mdi:fire",
                            "show_name": true,
                            "show_state": false,
                            "show_icon": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_warm_saturated_colors",
                              "target": {},
                              "data": {
                                "light": "light.group_all_inside_lights",
                                "only_on": true
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "script.change_received_lights_to_warm_saturated_colors",
                              "target": {},
                              "data": {
                                "light": "light.group_all_inside_lights",
                                "only_on": true
                              }
                            }
                          },
                          {
