                      "card_type": "media-player",
                      "button_type": "state",
                      "entity": "media_player.universal_kitchen_chromecast",
                      "name": "Kitchen TV",
                      "icon": "mdi:television",
                      "modules": [
                        "origami_base",
                        "origami_media",
                        "!default"
                      ],
                      "origami_base": {
                        "animate": true,
                        "hidden": "${states('input_select.origami_selected_tv') !== 'media_player.universal_kitchen_chromecast'}"
                      },
                      "origami_media": {
                        "layout": "tv",
                        "cover": "icon",
                        "collapse": true
                      },
                      "scrolling_effect": true,
                      "slider_live_update": false,
                      "cover_background": false,
                      "hide": {
                        "power_button": true,
                        "previous_button": true,
                        "next_button": true,
                        "volume_button": true,
                        "play_pause_button": true
                      },
                      "tap_action": {
                        "action": "more-info"
                      },
                      "button_action": {
                        "tap_action": {
                          "action": "more-info"
                        }
                      },
                      "rows": "auto",
                      "sub_button": {
                        "bottom_layout": "rows",
                        "main": [
                          {
                            "icon": "mdi:power",
                            "show_background": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "media_player.toggle",
                              "target": {
                                "entity_id": "media_player.universal_kitchen_chromecast"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "perform_action": "media_player.turn_off",
                              "target": {
                                "entity_id": "media_player.universal_kitchen_chromecast"
                              }
                            }
                          }
                        ],
                        "bottom": [
                          {
                            "name": "Playback",
                            "group": [
                              {
                                "icon": "mdi:skip-previous",
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "media_player.media_previous_track",
                                  "target": {
                                    "entity_id": "media_player.universal_kitchen_chromecast"
                                  }
                                }
                              },
                              {
                                "icon": "mdi:play",
                                "css_class": "play",
                                "entity": "media_player.universal_kitchen_chromecast",
                                "origami_base": {
                                  "icon": "${state === 'playing' ? 'mdi:pause' : ''}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "media_player.media_play_pause",
                                  "target": {
                                    "entity_id": "media_player.universal_kitchen_chromecast"
                                  }
                                }
                              },
                              {
                                "icon": "mdi:skip-next",
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "media_player.media_next_track",
                                  "target": {
                                    "entity_id": "media_player.universal_kitchen_chromecast"
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "name": "Volume",
                            "group": [
                              {
                                "entity": "media_player.universal_kitchen_chromecast",
                                "icon": "mdi:volume-high",
                                "show_background": false,
                                "origami_base": {
                                  "hidden": "${attr.is_volume_muted === true}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "media_player.volume_mute",
                                  "target": {
                                    "entity_id": "media_player.universal_kitchen_chromecast"
                                  },
                                  "data": {
                                    "is_volume_muted": true
                                  }
                                }
                              },
                              {
                                "entity": "media_player.universal_kitchen_chromecast",
                                "icon": "mdi:volume-off",
                                "show_background": false,
                                "origami_base": {
                                  "hidden": "${attr.is_volume_muted !== true}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "media_player.volume_mute",
                                  "target": {
                                    "entity_id": "media_player.universal_kitchen_chromecast"
                                  },
                                  "data": {
                                    "is_volume_muted": false
                                  }
                                }
                              },
                              {
                                "entity": "media_player.universal_kitchen_chromecast",
                                "sub_button_type": "slider",
                                "always_visible": true,
                                "slider_live_update": false
                              }
                            ]
                          }
                        ]
                      }
                    },
