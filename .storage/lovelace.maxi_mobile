                                  "disabled": "${!['playing', 'paused'].includes(states(states('input_select.origami_selected_speaker')))}"
                                },
                                "tap_action": {
                                  "action": "perform-action",
                                  "perform_action": "script.origami_playback",
                                  "data": {
                                    "speaker": "input_select.origami_selected_speaker",
                                    "command": "play_pause"
                                  }
                                },
