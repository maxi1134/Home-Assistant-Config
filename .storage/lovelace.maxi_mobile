              ],
              "button_type": "name",
              "show_header": true,
              "show_icon": false,
              "scrolling_effect": false,
              "margin": "7px",
              "margin_top_mobile": "0px",
              "margin_top_desktop": "20%",
              "popup_mode": "fit-content",
              "with_bottom_offset": true,
              "name": "Weather",
              "modules": [
                "origami_base",
                "origami_popup"
              ],
              "origami_base": {
                "animate": true
              },
              "origami_popup": {
                "gap": "var(--ha-space-4)",
                "value_style": "chip",
                "value_position": "beside"
              },
              "styles": ".bubble-pop-up { --ha-space-1:4px;--ha-space-2:8px;--ha-space-3:12px;--ha-space-4:16px;--ha-space-5:20px;--ha-card-border-radius:22px;--radius-ratio:0.35;--radius-inner:calc(var(--tile-size) * var(--radius-ratio));--radius-control:calc(var(--control-height-icon) * var(--radius-ratio));--radius-small:calc(var(--control-height-mini) * var(--radius-ratio));--radius-circle:var(--ha-border-radius-circle, 50%);--border-width:0;--border-color:color-mix(in srgb, var(--primary-text-color) var(--border-contrast), transparent);--card-ring:inset 0 0 0 var(--border-width) var(--border-color);--card-elevation:var(--card-shadow), var(--card-ring);--toggle-on:color-mix(in srgb, var(--primary-text-color) 85%, var(--ha-card-background));--fill-subtle:color-mix(in srgb, var(--fill-base) var(--fill-contrast), transparent);--fill-strong:color-mix(in srgb, var(--fill-base) 12%, transparent);--fill-loud:color-mix(in srgb, var(--fill-base) 30%, transparent);--fill-active:var(--toggle-on);--accent-color-background:color-mix(in srgb, var(--ok-color) var(--tint-strength), var(--ha-card-background));--tile-background:var(--fill-subtle);--tile-chip-shadow:var(--chip-shadow);--opacity-disabled:.3;--opacity-quiet:.45;--opacity-muted:.6;--opacity-strong:.8;--control-height-mini:var(--ha-space-8, 32px);--control-height-icon:var(--ha-space-10, 40px);--control-height-row:var(--ha-space-11, 44px);--control-height-list:var(--ha-space-12, 48px);--control-height-sm:var(--ha-space-13, 52px);--control-height:var(--ha-space-14, 56px);--control-height-lg:var(--ha-space-16, 64px);--tile-size:var(--ha-space-12, 48px);--tile-size-lg:var(--ha-space-20, 80px);--dot-size:12px;--icon-size-2xs:14px;--icon-size-xs:18px;--icon-size-s:var(--ha-space-5, 20px);--icon-size-m:var(--ha-space-6, 24px);--icon-size-l:var(--ha-space-7, 28px);--ha-font-size-xl:22px;--ha-font-size-l:18px;--ha-font-size-m:16px;--ha-font-size-s:14px;--ha-font-size-xs:14px;--primary-font-family:'Montserrat', sans-serif;--ha-