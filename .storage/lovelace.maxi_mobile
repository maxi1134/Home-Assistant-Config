            {
              "type": "custom:bubble-card",
              "card_type": "pop-up",
              "hash": "#lights",
              "button_type": "name",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "square": false,
                      "type": "grid",
                      "cards": [
                        {
                          "show_name": true,
                          "show_icon": true,
                          "type": "button",
                          "tap_action": {
                            "action": "toggle"
                          },
                          "entity": "script.changes_all_on_lights_to_warm_saturated_colors",
                          "name": "Warm colors",
                          "icon": "mdi:sun-thermometer"
                        },
                        {
                          "show_name": true,
                          "show_icon": true,
                          "type": "button",
                          "tap_action": {
                            "action": "toggle"
                          },
                          "entity": "script.changes_all_on_lights_to_warm_colors",
                          "name": "Pale Warm Colors"
                        },
                        {
                          "show_name": true,
                          "show_icon": true,
                          "type": "button",
                          "hold_action": {
                            "action": "perform-action",
                            "perform_action": "light.turn_on",
                            "target": {
                              "entity_id": "light.group_all_inside_lights"
                            },
                            "data": {
                              "color_temp_kelvin": 3283,
                              "brightness_pct": 100
                            }
                          },
                          "name": "White Lights",
                          "icon": "mdi:sun-thermometer",
                          "tap_action": {
                            "action": "perform-action",
                            "perform_action": "script.changes_all_on_lights_to_white",
                            "target": {}
                          }
                        },
                        {
                          "show_name": true,
                          "show_icon": true,
                          "type": "button",
                          "entity": "switch.group_all_uv_lamps"
                        },
                        {
                          "type": "custom:mushroom-chips-card",
                          "chips": [
                            {
                              "type": "template",
                              "icon": "mdi:lightbulb",
                              "icon_color": "{% if states('switch.adaptative_lighting_mains') == 'on' %}green {% endif %}",
                              "content": "Adaptative Lights",
                              "entity": "switch.adaptative_lighting_mains"
                            },
                            {
                              "type": "template",
                              "icon": "mdi:sun-thermometer",
                              "icon_color": "{% if states('switch.adaptive_lighting_adapt_color_adaptive_lighting') == 'on' %}green {% endif %}",
                              "content": "Adaptative Color",
                              "entity": "switch.adaptive_lighting_adapt_color_adaptive_lighting"
                            },
                            {
                              "type": "template",
                              "icon": "mdi:fire",
                              "icon_color": "{% if states('input_boolean.trippy_warm_colors_effect') == 'on' %}green {% endif %}",
                              "content": "Trippy Warm",
                              "entity": "input_boolean.trippy_warm_colors_effect"
                            }
                          ],
                          "alignment": "justify"
                        },
                        {
                          "type": "custom:mushroom-chips-card",
                          "chips": [
                            {
                              "type": "template",
                              "icon": "mdi:brightness-4",
                              "icon_color": "{% if states('switch.adaptive_lighting_adapt_brightness_adaptive_lighting') == 'on' %}green {% endif %}",
                              "content": "Adaptative Brightness",
                              "entity": "switch.adaptive_lighting_adapt_brightness_adaptive_lighting"
                            },
                            {
                              "type": "template",
                              "hold_action": {
                                "action": "toggle"
                              },
                              "entity": "switch.adaptive_lighting_sleep_mode_adaptive_lighting",
                              "icon": "mdi:sleep",
                              "icon_color": "{% if states('switch.adaptive_lighting_sleep_mode_adaptive_lighting') == 'on' %}\n      green {% endif %}",
                              "content": "Sleeping Lights"
                            },
                            {
                              "type": "template",
                              "icon": "mdi:dice-5-outline",
                              "icon_color": "{% if states('input_boolean.trippy_lights_effect') == 'on' %}green {% endif %}",
                              "content": "Trippy colors",
                              "entity": "input_boolean.trippy_lights_effect"
                            }
                          ],
                          "alignment": "justify"
                        }
