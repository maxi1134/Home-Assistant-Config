                {
                  "type": "conditional",
                  "title": "light.kitchen_1_light",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "light.kitchen_1_light",
                      "state": "on"
                    }
                  ],
                  "elements": [
                    {
                      "type": "custom:config-template-card",
                      "variables": {
                        "LIGHT_STATE": "states['light.kitchen_1_light'].state",
                        "COLOR_MODE": "states['light.kitchen_1_light'].attributes.color_mode",
                        "LIGHT_COLOR": "states['light.kitchen_1_light'].attributes.hs_color",
                        "BRIGHTNESS": "states['light.kitchen_1_light'].attributes.brightness",
                        "isInColoredMode": "colorMode => ['hs', 'rgb', 'rgbw', 'rgbww', 'white', 'xy'].includes(colorMode)"
                      },
                      "entities": [
                        "light.kitchen_1_light"
                      ],
                      "element": {
                        "type": "image",
                        "image": "${!isInColoredMode(COLOR_MODE) || (isInColoredMode(COLOR_MODE) && LIGHT_COLOR && LIGHT_COLOR[0] == 0 && LIGHT_COLOR[1] == 0) ? '/local/images/floorplan_2025/floorplan/light.kitchen_1_light.png?version=C80063D896F53F6D2AAA272C18F905A7' : '/local/images/floorplan_2025/floorplan/light.kitchen_1_light.red.png?version=B1EC399F68A6732B681C5E8B9DA130D5' }"
                      },
                      "style": {
                        "filter": "${ \"hue-rotate(\" + (isInColoredMode(COLOR_MODE) && LIGHT_COLOR ? LIGHT_COLOR[0] : 0) + \"deg) saturate(\" + (LIGHT_COLOR ? LIGHT_COLOR[1] / 100 : 1) + \")\"}",
                        "opacity": "${LIGHT_STATE === 'on' ? (BRIGHTNESS / 255) : '100'}",
                        "mix-blend-mode": "lighten",
                        "pointer-events": "none",
                        "left": "50%",
                        "top": "50%",
                        "width": "100%"
                      }
                    }
                  ]
                },
