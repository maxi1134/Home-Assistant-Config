                            "ha-markdown$": "/* sizes allow for the hallway Kiosk text zoom (~0.8): line boxes are px so the rows keep their height */\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\nth, td {\n  border: none !important;\n  padding: 1px 3px !important;\n  vertical-align: middle;\n  white-space: nowrap;\n}\nth {\n  font-size: 18px;\n  line-height: 22px;\n  font-weight: 500;\n  text-align: left;\n  padding: 0 3px 5px !important;\n}\na {\n  display: block;\n  color: inherit !important;\n  text-decoration: none !important;\n  -webkit-tap-highlight-color: transparent;\n}\nth[align=\"right\"] {\n  text-align: right;\n  font-weight: 400;\n  opacity: 0.6;\n}\ntd {\n  font-size: 20px;\n  line-height: 21px;\n}\ntd:nth-child(3n + 1) {\n  width: 1%;\n  padding-right: 8px !important;\n}\ntd:nth-child(3n + 3) {\n  text-align: right;\n  padding-right: 10px !important;\n}\ntd:nth-child(3) {\n  border-right: 1px solid var(--divider-color) !important;\n}\ntd:nth-child(4) {\n  padding-left: 10px !important;\n}\ntd small {\n  font-size: 14px;\n  opacity: 0.7;\n}\ntd:nth-child(3n + 2) small {\n  display: block;\n  line-height: 15px;\n}\ntd:nth-child(3n + 3) b {\n  font-size: 26px;\n}\ntd:nth-child(3n + 1) font {\n  display: inline-block;\n  min-width: 38px;\n  padding: 3px 5px;\n  border-radius: 7px;\n  background: currentColor;\n  text-align: center;\n  font-size: 19px;\n  line-height: 22px;\n}\ntd:nth-child(3n + 1) font > b {\n  color: #fff;\n}\nha-icon {\n  --mdc-icon-size: 14px;\n  display: inline-block;\n  height: 14px;\n  line-height: 14px;\n  vertical-align: -2px;\n  margin-right: 1px;\n}\nth ha-icon {\n  --mdc-icon-size: 20px;\n  height: 20px;\n  line-height: 20px;\n  margin-right: 6px;\n  vertical-align: -4px;\n}\n"
                          }
