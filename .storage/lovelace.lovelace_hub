          "layout": {
            "grid-template-columns": "34% 48.1% 17.9%",
            "grid-template-rows": null
          },
          "theme": "greenwave"
        },
        {
          "type": "custom:grid-layout",
          "title": "hallway_desk_tablet",
          "path": "hallway-desk-tablet",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "clock",
                    "clock_style": "digital",
                    "clock_size": "small",
                    "show_seconds": true,
                    "no_background": false,
                    "view_layout": {
                      "grid-area": "clock"
                    },
                    "date_format": [
                      "weekday-long",
                      "day-2-digit",
                      "month-long",
                      "year-numeric"
                    ],
                    "card_mod": {
                      "style": "{# fill the left column down to the bottom edge; stock size while the cooking timer bar is shown #}\n{% if not is_state('timer.cooking', 'active') %}\nha-card {\n  height: 67px;\n  --ha-clock-card-digital-font-size-small: 38px;\n  --ha-font-size-xs: 13px;\n  --ha-font-size-s: 15px;\n}\n{% endif %}"
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "timer.cooking",
                      "state": "active"
                    }
                  ],
                  "card": {
                    "type": "custom:timer-bar-card",
                    "entity": "timer.cooking"
                  }
                },
                {
                  "type": "custom:frigate-events-card",
                  "frigate_client_id": "frigate",
                  "event_count": 2,
                  "cameras": [
                    "front_door_camera"
                  ],
                  "live_view": true,
                  "live_view_entity": "camera.front_door_camera",
                  "go2rtc_url": "http://192.168.0.11:1984",
                  "go2rtc_stream": "front_door_camera_sub",
                  "live_view_aspect_ratio": "4/3",
                  "card_mod": {
                    "style": "{# kink/acid hide the clock and the cooking timer adds its bar under a stock-size clock: resize the live view so the column still ends at the bottom edge (y=794) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set timer = is_state('timer.cooking', 'active') %}\n{% if timer or not clock_shown %}\n.live-view-container {\n  aspect-ratio: 417 / {{ (264 if clock_shown else 351) if timer else 422 }} !important;\n}\n.live-view-video {\n  object-fit: cover !important;\n}\n{% endif %}"
                  }
                },
                {
                  "type": "custom:frigate-events-card",
                  "frigate_client_id": "frigate",
                  "event_count": 3,
                  "cameras": [
                    "back_door_camera",
                    "back_yard_camera",
                    "parking_exit_camera"
                  ]
                }
              ]
            },
            {
              "cards": [
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_hallway_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 33px bars */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_hallway_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_hallway_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 33px bar */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_hallway_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_hallway_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 51px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 33px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 104px (keeps the space the old light cards used) */\nha-card {\n  height: 104px !important;\n  overflow: hidden;\n}\n"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "media_player.mass_hallway_wiim_speaker",
                      "state_not": "playing"
                    }
                  ],
                  "card": {
                    "type": "custom:vertical-stack-in-card",
                    "cards": [
                      {
                        "show_current": true,
                        "show_forecast": false,
                        "type": "weather-forecast",
                        "entity": "weather.weather_montreal_forecast",
                        "forecast_type": "daily"
