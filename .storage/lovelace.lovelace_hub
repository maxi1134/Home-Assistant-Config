                          "state": "off"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.acid_time",
                          "state": "off"
                        }
                      ],
                      "card": {
                        "type": "custom:layout-card",
                        "layout_type": "custom:grid-layout",
                        "layout": {
                          "grid-template-columns": "85% auto",
                          "grid-template-rows": "auto",
                          "grid-template-areas": "\"clock temperature\"\n"
                        },
                        "cards": [
                          {
                            "type": "clock",
                            "clock_style": "digital",
                            "clock_size": "small",
                            "show_seconds": true,
                            "no_background": false,
                            "view_layout": {
                              "grid-area": "clock"
                            },
                            "date_format": [
                              "weekday-long",
                              "day-2-digit",
                              "month-long",
                              "year-numeric"
                            ]
