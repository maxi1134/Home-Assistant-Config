                        "style": "{# fit the page to the screen: the buttons take what's left above the covers row (the closet speaker adds its mini player; since 2026-10-25 the light block keeps the same height in kink/acid, so the mode no longer matters) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set player = not is_state('media_player.mass_closet_aux2_speaker', 'off') %}\nha-card {\n  height: {{ 43 if player else 168 }}px !important;\n  {% if player %}padding: 4px 0 !important;{% endif %}\n}\n{% if player %}\nha-state-icon {\n  display: none;\n}\n{% endif %}"
