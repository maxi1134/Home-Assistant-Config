        {
          "title": "Server Tablet",
          "path": "server-tablet",
          "type": "panel",
          "theme": "Caule Dark Gray",
          "badges": [],
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "custom:mod-card",
                    "card_mod": {
                      "style": {
                        "layout-card$": {
                          "grid-layout$": "#root {\n  padding: 0px !important;\n  margin: 0px !important;\n  column-gap: 8px !important;\n}\n#root > * {\n  margin: 0px !important;\n}\n"
                        }
                      }
                    },
                    "card": {
                      "type": "custom:layout-card",
                      "layout_type": "custom:grid-layout",
                      "layout": {
                        "grid-template-columns": "75% auto",
                        "grid-template-rows": "auto",
                        "grid-template-areas": "\"clock temperature\"\n"
                      },
                      "cards": [
                        {
                          "type": "clock",
                          "clock_style": "digital",
                          "clock_size": "small",
