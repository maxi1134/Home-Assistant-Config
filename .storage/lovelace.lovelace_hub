                            "left": "50%",
                            "mix-blend-mode": "normal",
                            "opacity": "50%",
                            "top": "50%",
                            "width": "100%"
                          },
                          "type": "image"
                        },
                        {
                          "entity": "binary_sensor.group_hotbox_down_motion_occupancy",
                          "image": "/local/images/motion_plan/hotbox_on.png",
                          "state_filter": {
                            "on": "brightness(100%) saturate(3)",
                            "off": "brightness(0%)"
                          },
                          "style": {
                            "left": "50%",
                            "mix-blend-mode": "normal",
                            "opacity": "50%",
                            "top": "50%",
                            "width": "100%"
                          },
                          "type": "image"
                        },
                        {
                          "entity": "binary_sensor.group_hotbox_top_motion_occupancy",
                          "image": "/local/images/motion_plan/hotbox_on.png",
                          "state_filter": {
                            "on": "brightness(100%) saturate(3)",
                            "off": "brightness(0%)"
                          },
                          "style": {
                            "left": "50%",
                            "mix-blend-mode": "normal",
                            "opacity": "50%",
                            "top": "50%",
                            "width": "100%"
                          },
                          "type": "image"
                        },
                        {
                          "entity": "binary_sensor.group_lounge_motion_occupancy",
                          "image": "/local/images/motion_plan/lounge_on.png",
                          "state_filter": {
                            "on": "brightness(100%) saturate(3)",
                            "off": "brightness(0%)"
                          },
                          "style": {
                            "left": "50%",
                            "mix-blend-mode": "normal",
                            "opacity": "50%",
                            "top": "50%",
                            "width": "100%"
                          },
                          "type": "image"
                        },
                        {
                          "entity": "binary_sensor.group_patio_motion_occupancy",
                          "image": "/local/images/motion_plan/patio_on.png",
                          "state_filter": {
                            "on": "brightness(100%) saturate(3)",
                            "off": "brightness(0%)"
                          },
                          "style": {
                            "left": "50%",
                            "mix-blend-mode": "normal",
                            "opacity": "50%",
                            "top": "50%",
                            "width": "100%"
                          },
                          "type": "image"
                        }
                      ],
                      "type": "picture-elements",
                      "image": "/local/images/motion_plan/background.png"
                    }
                  ]
                }
              ]
            }
          ],
          "layout": {
            "grid-template-columns": "34% 48.1% 17.9%",
            "grid-template-rows": null
          },
          "theme": "synthwave"
        },
        {
          "type": "custom:grid-layout",
          "title": "hotbox_bed_tablet",
          "path": "hotbox-bed-tablet",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "clock",
                    "clock_style": "digital",
                    "clock_size": "small",
                    "show_seconds": true,
                    "no_background": false,
                    "view_layout": {
                      "grid-area": "clock"
                    },
                    "date_format": [
                      "weekday-long",
                      "day-2-digit",
                      "month-long",
                      "year-numeric"
                    ],
                    "card_mod": {
                      "style": "/* fits the left column to the screen: the sleeper button ends level with the middle column */\nha-card {\n  height: 83px !important;\n  --ha-clock-card-digital-font-size-small: 52px;\n  --ha-font-size-xs: 16px;\n  --ha-font-size-s: 19px;\n}"
                    }
                  }
                },
                {
                  "type": "custom:enhanced-shutter-card",
                  "entities": [
                    {
                      "entity": "cover.cover_hotbox_bed_door",
                      "name": " ",
                      "closing_direction": "right",
                      "buttons_position": "bottom",
                      "shutter_preset": "curtain",
                      "inline_header": true,
                      "window_image": "esc-window3.png",
                      "resize_width_pct": 160,
                      "resize_height_pct": 120,
                      "view_image": "hotbox_view.png",
                      "top_offset_pct": 0,
                      "shutter_slat_image": "black-curtain.png",
                      "button_up_hide_states": [
                        "open",
                        "opening",
                        "closing"
                      ],
                      "button_stop_hide_states": [
                        "open",
                        "closed",
                        "partial_open"
                      ],
                      "button_down_hide_states": [
                        "closed",
                        "opening",
                        "closing"
                      ]
                    }
                  ]
                },
                {
                  "show_name": true,
                  "show_icon": true,
                  "type": "button",
                  "entity": "input_boolean.sleeper_in_hotbox",
                  "icon": "mdi:sleep",
                  "name": "Sleeping [Mode] Dodo",
                  "card_mod": {
                    "style": "{# kink/acid hide the clock: the sleeper button takes its slot so the column still ends at the bottom edge #}\n{% if not (is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off')) %}\nha-card {\n  height: 281px !important;\n}\n{% endif %}"
                  }
                }
              ]
            },
            {
              "cards": [
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_hotbox_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 33px bars */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_hotbox_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_hotbox_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 33px bar */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_hotbox_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_hotbox_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 51px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 33px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 104px (keeps the space the old light cards used) */\nha-card {\n  height: 104px !important;\n  overflow: hidden;\n}\n"
                  }
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.mass_hotbox_wiim_speaker",
                          "state_not": "off"
                        },
                        {
                          "condition": "state",
                          "entity": "media_player.mass_hotbox_wiim_speaker",
                          "state_not": "idle"
                        }
                      ],
                      "card": {
                        "type": "custom:yet-another-media-player",
                        "entities": [
                          {
                            "entity_id": "media_player.mass_hotbox_wiim_speaker"
                          }
                        ],
                        "card_type": "default",
                        "dim_chips_on_idle": true,
                        "appearance": "dark",
                        "alternate_progress_bar": true,
                        "match_theme": true,
                        "display_timestamps": true,
                        "search_view": "list",
                        "control_layout": "classic",
                        "swap_pause_for_stop": false,
                        "adaptive_controls": true,
                        "hide_active_entity_label": false,
                        "adaptive_text_targets": [],
                        "details_alignment": "left",
                        "volume_mode": "slider",
                        "volume_step": 0.02,
                        "collapse_on_idle": false,
                        "hide_menu_player": false,
                        "extend_artwork": false,
                        "always_show_lyrics": true,
                        "lyrics_mode": "default",
                        "lyrics_pre_roll": 0,
                        "queue_controls_style": "drag_handle",
                        "card_height": "{# hotbox WiiM, above the TV card. Alone 335; with the TV shown: TV muted -> the rest, WiiM muted -> 110 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set tv_m = is_state_attr('media_player.universal_hotbox_top_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_hotbox_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 469 %}\n{% if states('media_player.universal_hotbox_top_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 140) if tv_m and not mu_m else (110 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ 335 }}\n{% endif %}",
                        "lyrics_source": "mass_lrclib",
                        "idle_timeout_ms": 0,
                        "card_mod": {
                          "style": "{# ☰ room (follow-up to Maxi's 2026-10-25 mute split): below 320 px this classic-layout YAMP drops its volume row and floats ☰ at the bottom right of the play row, where it covered the power button. While compact, keep room for it.\nThe block below is a copy of this card's card_height; keep the two in sync. #}\n{% set h %}{# hotbox WiiM, above the TV card. Alone 335; with the TV shown: TV muted -> the rest, WiiM muted -> 110 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set tv_m = is_state_attr('media_player.universal_hotbox_top_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_hotbox_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 469 %}\n{% if states('media_player.universal_hotbox_top_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 140) if tv_m and not mu_m else (110 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ 335 }}\n{% endif %}{% endset %}\n{% if (h | trim | float(999)) < 320 %}\n.controls-row.adaptive {\n  padding-right: 52px !important;\n  --yamp-control-gap: 4px !important;\n  --yamp-control-min-width: 36px !important;\n}\n{% endif %}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.universal_hotbox_top_chromecast",
                          "state_not": [
                            "off",
                            "unavailable"
                          ]
                        }
                      ],
                      "card": {
                        "type": "custom:yet-another-media-player",
                        "entities": [
                          {
                            "entity_id": "media_player.universal_hotbox_top_chromecast"
                          }
                        ],
                        "card_type": "default",
                        "dim_chips_on_idle": true,
                        "appearance": "dark",
                        "alternate_progress_bar": false,
                        "match_theme": false,
                        "display_timestamps": true,
                        "search_view": "card_minimal",
                        "control_layout": "modern",
                        "swap_pause_for_stop": false,
                        "adaptive_controls": false,
                        "hide_active_entity_label": false,
                        "adaptive_text_targets": [],
                        "details_alignment": "left",
                        "volume_mode": "slider",
                        "volume_step": 0.02,
                        "collapse_on_idle": false,
                        "hide_menu_player": false,
                        "extend_artwork": false,
                        "card_height": "{# hotbox TV, under the WiiM card. Alone 335; with the WiiM card shown the pair fills the column to the bottom edge: TV muted -> 140 strip, WiiM muted -> the rest, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set tv_m = is_state_attr('media_player.universal_hotbox_top_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_hotbox_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 469 %}\n{% if states('media_player.mass_hotbox_wiim_speaker') not in ['off', 'idle'] %}\n{{ (140 if tv_m and not mu_m else ((pair - 110) if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ 335 }}\n{% endif %}",
                        "idle_timeout_ms": 0,
                        "card_mod": {
                          "style": "{# TV mute button (Maxi 2026-10-25: a way to unmute the muted TV). Below 320 px YAMP hides the volume row's mute button with an inline style; show it again (not while the options sheet is open).\nIn the strip (TV muted, music not) the volume row sits below the visible card, so lift the button into the play/skip row, left edge, styled like those buttons. #}\n{% set tv_m = is_state_attr('media_player.universal_hotbox_top_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_hotbox_wiim_speaker', 'is_volume_muted', true) %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  visibility: visible !important;\n  opacity: 1 !important;\n  pointer-events: auto !important;\n}\n{% if tv_m and not mu_m %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  transform: translate(-44px, -50px);\n}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] .volume-icon-btn {\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);\n}\n{% endif %}\n"
                        }
                      }
                    }
                  ]
                },
                {
