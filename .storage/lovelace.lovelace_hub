                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 28px bar */\nha-card {\n  --mush-icon-size: 28px;\n  --icon-size: 28px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
