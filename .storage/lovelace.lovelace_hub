                        "style": "{# kink/acid hide the clock: stretch the live view so the column still reaches the bottom edge (stock while the cooking timer bar is shown) #}\n{% if not (is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off')) and not is_state('timer.cooking', 'active') %}\n.live-view-container {\n  aspect-ratio: 1 / 1 !important;\n}\n.live-view-video {\n  object-fit: cover !important;\n}\n{% endif %}"
