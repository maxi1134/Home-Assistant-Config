        {
          "title": "workshop_sec_tablet",
          "path": "workshop-sec-tablet",
          "type": "panel",
          "theme": "Caule Dark Gray",
          "badges": [],
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "custom:mod-card",
                    "card_mod": {
                      "style": {
                        "layout-card$": {
                          "grid-layout$": "#root {\n  padding: 0px !important;\n  margin: 0px !important;\n  column-gap: 8px !important;\n}\n#root > * {\n  margin: 0px !important;\n}\n"
                        }
                      }
                    },
                    "card": {
                      "type": "custom:layout-card",
                      "layout_type": "custom:grid-layout",
                      "layout": {
                        "grid-template-columns": "75% auto",
                        "grid-template-rows": "auto",
                        "grid-template-areas": "\"clock temperature\"\n"
                      },
                      "cards": [
                        {
                          "type": "clock",
                          "clock_style": "digital",
                          "clock_size": "small",
                          "show_seconds": true,
                          "no_background": false,
                          "view_layout": {
                            "grid-area": "clock"
                          },
                          "date_format": [
                            "weekday-long",
                            "day-2-digit",
                            "month-long",
                            "year-numeric"
                          ],
                          "card_mod": {
                            "style": "/* the flush row drops 24px of grid margins; the taller clock gives them back so the cards below don't move */\nha-card {\n  height: 88px !important;\n  --ha-clock-card-digital-font-size-small: 54px;\n  --ha-font-size-xs: 16px;\n  --ha-font-size-s: 19px;\n}"
                          }
                        },
                        {
                          "type": "markdown",
                          "content": "<center>    {{states(\"sensor.outside_temperature_with_fallback\")+\"°\" }} </center>",
                          "card_mod": {
                            "style": "ha-card {\n  font-size: 24px;\n  height: 88px !important;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_workshop_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 40.75px bars */\nha-card {\n  --mush-icon-size: 40.75px;\n  --icon-size: 40.75px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_workshop_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_workshop_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 40.75px bar */\nha-card {\n  --mush-icon-size: 40.75px;\n  --icon-size: 40.75px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_workshop_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_workshop_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 58.75px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 40.75px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 119.5px (keeps the space the old light cards used) */\nha-card {\n  height: 119.5px !important;\n  overflow: hidden;\n}\n"
                  }
