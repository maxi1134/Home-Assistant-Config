{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.lovelace_hub",
  "data": {
    "config": {
      "views": [
        {
          "type": "custom:grid-layout",
          "title": "lounge_new",
          "path": "office-new",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "clock",
                    "clock_style": "digital",
                    "clock_size": "small",
                    "show_seconds": true,
                    "no_background": false,
                    "view_layout": {
                      "grid-area": "clock"
                    },
                    "date_format": [
                      "weekday-long",
                      "day-2-digit",
                      "month-long",
                      "year-numeric"
                    ]
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "timer.cooking",
                      "state": "active"
                    }
                  ],
                  "card": {
                    "type": "custom:timer-bar-card",
                    "entity": "timer.cooking"
                  }
                },
                {
                  "type": "custom:frigate-events-card",
                  "frigate_client_id": "frigate",
                  "event_count": 2,
                  "cameras": [
                    "front_door_camera"
                  ],
                  "live_view": true,
                  "live_view_entity": "camera.front_door_camera",
                  "go2rtc_url": "http://192.168.0.11:1984",
                  "go2rtc_stream": "front_door_camera_sub",
                  "live_view_aspect_ratio": "4/3",
                  "card_mod": {
                    "style": "{# kink/acid hide the clock and the cooking timer adds its bar under the clock: resize the live view so the left column still ends at y=792 (salon tablet, 853x533 CSS) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set timer = is_state('timer.cooking', 'active') %}\n{% if timer or not clock_shown %}\n.live-view-container {\n  aspect-ratio: {{ ('287 / 168' if clock_shown else '287 / 226') if timer else '287 / 274' }} !important;\n}\n.live-view-video {\n  object-fit: cover !important;\n}\n{% endif %}\n"
                  }
                },
                {
                  "type": "custom:frigate-events-card",
                  "frigate_client_id": "frigate",
                  "event_count": 3,
                  "cameras": [
                    "back_door_camera",
                    "back_yard_camera",
                    "parking_exit_camera"
                  ]
                }
              ]
            },
            {
              "cards": [
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_salon_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 33px bars */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_salon_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_salon_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 33px bar */\nha-card {\n  --mush-icon-size: 33px;\n  --icon-size: 33px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_salon_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_salon_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 51px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 33px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 104px (keeps the space the old light cards used) */\nha-card {\n  height: 104px !important;\n  overflow: hidden;\n}\n"
                  }
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.mass_salon_wiim_speaker",
                          "state_not": "off"
                        },
                        {
                          "condition": "state",
                          "entity": "media_player.mass_salon_wiim_speaker",
                          "state_not": "idle"
                        }
                      ],
                      "card": {
                        "type": "custom:yet-another-media-player",
                        "entities": [
                          {
                            "entity_id": "media_player.mass_salon_wiim_speaker"
                          }
                        ],
                        "card_type": "default",
                        "dim_chips_on_idle": true,
                        "appearance": "dark",
                        "alternate_progress_bar": true,
                        "match_theme": true,
                        "display_timestamps": true,
                        "search_view": "list",
                        "control_layout": "classic",
                        "swap_pause_for_stop": false,
                        "adaptive_controls": true,
                        "hide_active_entity_label": false,
                        "adaptive_text_targets": [],
                        "details_alignment": "left",
                        "volume_mode": "slider",
                        "volume_step": 0.02,
                        "collapse_on_idle": false,
                        "hide_menu_player": false,
                        "extend_artwork": false,
                        "card_height": "{# salon WiiM, above the TV mini player (853x533 CSS): alone it fills the middle column to y=792 (410); with the TV shown the pair fills it: TV muted -> the rest (the TV is a 110px strip), WiiM muted -> 105 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set tv_m = is_state_attr('media_player.universal_salon_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_salon_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 402 %}\n{% if not is_state('media_player.universal_salon_chromecast', 'off') %}\n{{ ((pair - 110) if tv_m and not mu_m else (105 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ 410 }}\n{% endif %}",
                        "always_show_lyrics": true,
                        "lyrics_mode": "default",
                        "lyrics_pre_roll": 0,
                        "queue_controls_style": "drag_handle",
                        "idle_timeout_ms": 0,
                        "card_mod": {
                          "style": "{# ☰ room (follow-up to Maxi's 2026-10-25 mute split): below 320 px this classic-layout YAMP drops its volume row and floats ☰ at the bottom right of the play row, where it covered the power button. While compact, keep room for it.\nThe block below is a copy of this card's card_height; keep the two in sync. #}\n{% set h %}{# salon WiiM, above the TV mini player (853x533 CSS): alone it fills the middle column to y=792 (410); with the TV shown the pair fills it: TV muted -> the rest (the TV is a 110px strip), WiiM muted -> 105 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set tv_m = is_state_attr('media_player.universal_salon_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_salon_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 402 %}\n{% if not is_state('media_player.universal_salon_chromecast', 'off') %}\n{{ ((pair - 110) if tv_m and not mu_m else (105 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ 410 }}\n{% endif %}{% endset %}\n{% if (h | trim | float(999)) < 320 %}\n.controls-row.adaptive {\n  padding-right: 52px !important;\n  --yamp-control-gap: 4px !important;\n  --yamp-control-min-width: 36px !important;\n}\n{% endif %}\n"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.universal_salon_chromecast",
                          "state_not": "off"
                        }
                      ],
                      "card": {
                        "type": "custom:mini-media-player",
                        "entity": "media_player.universal_salon_chromecast",
                        "group": true,
                        "volume_stateless": false,
                        "toggle_power": true,
                        "artwork": "full-cover",
                        "scale": "1",
                        "lyrics_source": "mass_lrclib",
                        "card_mod": {
                          "style": {
                            ".": "/* salon tablet: alone it fills the middle column to y=792 (413; renders ~3 px short); under the WiiM card it is compact (no artwork aspect box, one-line info, no source menu) and: TV muted -> 110px strip, WiiM muted -> the rest, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) */\n{% set tv_m = is_state_attr('media_player.universal_salon_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_salon_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = 402 %}\n{% set shown = states('media_player.mass_salon_wiim_speaker') not in ['off', 'idle'] %}\n{% set strip = shown and tv_m and not mu_m %}\n{% set h = (110 if strip else ((pair - 105) if mu_m and not tv_m else pair / 2)) if shown else 413 %}\nha-card {\n  height: {{ h }}px;\n}\n{% if shown %}\nha-card:before {\n  padding-top: 0 !important;\n}\n.entity__info__media {\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-height: 1.6em;\n}\n{% endif %}\n:host {\n  --mini-media-player-overlay-base-color: white;\n  --mini-media-player-overlay-accent-color: red;\n  --mini-media-player-media-cover-info-color: white;\n  --mini-media-player-accent-color: red;\n  --mini-media-player-background-opacity: 1;\n  --mini-media-player-progress-height: 10px;\n  --mini-media-player-button-color: rgba(0,0,0,0.75);\n  } \n",
                            "mmp-powerstrip$": "{% set tv_m = is_state_attr('media_player.universal_salon_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_salon_wiim_speaker', 'is_volume_muted', true) %}\n{% set shown = states('media_player.mass_salon_wiim_speaker') not in ['off', 'idle'] %}\n{% set strip = shown and tv_m and not mu_m %}\n{% if shown %}\nmmp-source-menu {\n  display: none !important;\n}\n{% endif %}\n"
                          }
                        },
                        "hide": {
                          "play_stop": false
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "show_name": true,
                      "show_icon": true,
                      "show_state": true,
                      "type": "glance",
                      "entities": [
                        {
                          "entity": "input_boolean.aerating_apartment"
                        },
                        {
                          "entity": "input_boolean.acid_time"
                        },
                        {
                          "entity": "input_boolean.party_mode"
                        },
                        {
                          "entity": "input_boolean.kink_party"
                        },
                        {
                          "entity": "input_boolean.waiting_package"
                        }
                      ],
                      "columns": 5,
                      "card_mod": {
                        "style": "/* nothing playing: sized so the third tile row ends at y=792 and the fourth stays below the edge (salon tablet) */\nha-card {\n  height: 145px !important;\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n"
                      }
                    },
                    {
                      "type": "horizontal-stack",
                      "cards": [
