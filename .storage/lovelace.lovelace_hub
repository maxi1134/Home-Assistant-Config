                        {
                          "type": "markdown",
                          "content": "<center>    {{states(\"sensor.outside_temperature_with_fallback\")+\"°\" }} </center>",
                          "card_mod": {
                            "style": "ha-card {\n  font-size: 24px;\n}\n"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_patio_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 41px bars */\nha-card {\n  --mush-icon-size: 41px;\n  --icon-size: 41px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n",
                          "mushroom-button:nth-child(2)$": ".button {\n  animation: ping 1.7s infinite;\n}\n@keyframes ping {\n  0% { box-shadow: 0 0 0 0 rgba(var(--rgb-white), 0.7); }\n  70% { box-shadow: 0 0 0 10px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_patio_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_patio_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 41px bar */\nha-card {\n  --mush-icon-size: 41px;\n  --icon-size: 41px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n",
                            "mushroom-light-color-control$": {
                              "mushroom-slider$": ".slider {\n  animation: ping 1.6s infinite;\n}\n@keyframes ping {\n  0% { box-shadow: 0 0 0 0 rgba(var(--rgb-white), 0.7); }\n  70% { box-shadow: 0 0 0 10px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_patio_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_patio_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 59px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 41px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n  animation: ping 1.6s infinite;\n}\n@keyframes ping {\n  0% { box-shadow: 0 0 0 0 rgba(var(--rgb-white), 0.7); }\n  70% { box-shadow: 0 0 0 10px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 120px (keeps the space the old light cards used) */\nha-card {\n  height: 120px !important;\n  overflow: hidden;\n}\n"
                  }
                },
