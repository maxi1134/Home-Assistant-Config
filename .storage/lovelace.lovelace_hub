                        "sun_entity": "sun.sun",
                        "temperature_sensor": "sensor.sensor_outside_temperature_temperature",
                        "humidity_sensor": "sensor.sensor_outside_temperature_humidity",
                        "weather_icon_type": "fill",
                        "animated_icon": true,
                        "forecast_rows": 2,
                        "locale": "en-GB",
                        "time_pattern": "HH:mm",
                        "time_format": 24,
                        "date_pattern": "ccc, d.MM.yy",
                        "hide_today_section": true,
                        "hide_forecast_section": false,
                        "show_humidity": true,
                        "hide_clock": true,
                        "hide_date": true,
                        "hourly_forecast": true,
                        "show_decimal": true
                      }
                    ],
                    "card_mod": {
                      "style": "{# speaker switched off: no player below, so the weather card takes the 11px the column would leave empty #}\n{% if is_state('media_player.mass_hallway_wiim_speaker', 'off') %}\nha-card {\n  min-height: 177.33px !important;\n}\n{% endif %}\n"
                    }
                  }
                },
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "conditional",
                      "conditions": [
