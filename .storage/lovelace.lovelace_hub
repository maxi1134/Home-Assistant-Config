        {
          "type": "panel",
          "title": "bedroom_tablet",
          "path": "bedroom-tablet",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "input_boolean.kink_party",
                      "state": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "input_boolean.acid_time",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "custom:layout-card",
                    "layout_type": "custom:grid-layout",
                    "layout": {
                      "grid-template-columns": "80% auto",
                      "grid-template-rows": "auto",
                      "grid-template-areas": "\"clock temperature\"\n"
                    },
                    "cards": [
                      {
                        "type": "clock",
                        "clock_style": "digital",
                        "clock_size": "small",
                        "show_seconds": true,
                        "no_background": false,
                        "view_layout": {
                          "grid-area": "clock"
                        },
                        "date_format": [
                          "weekday-long",
                          "day-2-digit",
                          "month-long",
                          "year-numeric"
                        ]
                      },
                      {
                        "type": "markdown",
                        "content": "<center>    {{states(\"sensor.outside_temperature_with_fallback\")+\"°\" }} </center>",
                        "card_mod": {
                          "style": "ha-card {\n  font-size: 24px;\n}\n"
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "custom:vertical-stack-in-card",
                  "cards": [
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_bedroom_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "secondary_info": "none",
                      "icon_type": "none",
                      "layout": "horizontal",
                      "use_light_color": true,
                      "collapsible_controls": false,
                      "show_brightness_control": true,
                      "show_color_temp_control": true,
                      "show_color_control": false,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "hold_action": {
                        "action": "toggle"
                      },
                      "double_tap_action": {
                        "action": "toggle"
                      },
                      "card_mod": {
                        "style": {
                          ".": "/* Maxi 2026-10-25: standard light block on every tablet: brightness + colour temperature row, 41px bars */\nha-card {\n  --mush-icon-size: 41px;\n  --icon-size: 41px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_bedroom_lights",
                          "state": "on"
                        }
                      ],
                      "card": {
                        "type": "custom:mushroom-light-card",
                        "entity": "light.group_bedroom_lights",
                        "fill_container": true,
                        "primary_info": "none",
                        "secondary_info": "none",
                        "icon_type": "none",
                        "layout": "horizontal",
                        "use_light_color": true,
                        "collapsible_controls": false,
                        "show_brightness_control": false,
                        "show_color_temp_control": false,
                        "show_color_control": true,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": {
                            ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 41px bar */\nha-card {\n  --mush-icon-size: 41px;\n  --icon-size: 41px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n"
                          }
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.group_bedroom_lights",
                          "state_not": "on"
                        }
                      ],
                      "card": {
                        "type": "button",
                        "entity": "light.group_bedroom_lights",
                        "show_name": false,
                        "show_icon": false,
                        "show_state": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "toggle"
                        },
                        "double_tap_action": {
                          "action": "toggle"
                        },
                        "card_mod": {
                          "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 59px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 41px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n}\n"
                        }
                      }
                    }
                  ],
                  "card_mod": {
                    "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 120px (keeps the space the old light cards used) */\nha-card {\n  height: 120px !important;\n  overflow: hidden;\n}\n"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "media_player.mass_bedroom_vpe_speaker",
                      "state_not": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "media_player.mass_bedroom_vpe_speaker",
                      "state_not": "idle"
                    },
                    {
                      "condition": "state",
                      "entity": "media_player.mass_bedroom_vpe_speaker",
                      "state_not": "unavailable"
                    }
                  ],
                  "card": {
                    "type": "custom:yet-another-media-player",
                    "entities": [
                      {
                        "entity_id": "media_player.mass_bedroom_vpe_speaker"
                      }
                    ],
                    "card_type": "default",
                    "dim_chips_on_idle": true,
                    "appearance": "dark",
                    "alternate_progress_bar": false,
                    "match_theme": false,
                    "display_timestamps": true,
                    "search_view": "card_minimal",
                    "control_layout": "modern",
                    "swap_pause_for_stop": false,
                    "adaptive_controls": false,
                    "hide_active_entity_label": false,
                    "adaptive_text_targets": [],
                    "details_alignment": "left",
                    "volume_mode": "slider",
                    "volume_step": 0.02,
                    "collapse_on_idle": false,
                    "hide_menu_player": false,
                    "extend_artwork": false,
                    "card_height": "{# bedroom speaker, above the TV card. Alone 628/724; with the TV shown: TV muted -> the rest, speaker muted -> 145 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_bedroom_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_bedroom_vpe_speaker', 'is_volume_muted', true) %}\n{% set pair = (620 if clock_shown else 716) %}\n{% if states('media_player.universal_bedroom_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 145) if tv_m and not mu_m else (145 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (628 if clock_shown else 724) }}\n{% endif %}",
                    "always_show_lyrics": true,
                    "lyrics_mode": "default",
                    "lyrics_pre_roll": 17,
                    "lyrics_source": "lrclib",
                    "search_results_sort": "play_count_desc",
                    "idle_timeout_ms": 0
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "media_player.universal_bedroom_chromecast",
                      "state_not": "off"
                    },
                    {
                      "condition": "state",
                      "entity": "media_player.universal_bedroom_chromecast",
                      "state_not": "unavailable"
                    }
                  ],
                  "card": {
                    "type": "custom:yet-another-media-player",
                    "entities": [
                      {
                        "entity_id": "media_player.universal_bedroom_chromecast"
                      }
                    ],
                    "card_type": "default",
                    "dim_chips_on_idle": true,
                    "appearance": "dark",
                    "alternate_progress_bar": false,
                    "match_theme": false,
                    "display_timestamps": true,
                    "search_view": "card_minimal",
                    "control_layout": "modern",
                    "swap_pause_for_stop": false,
                    "adaptive_controls": false,
                    "hide_active_entity_label": false,
                    "adaptive_text_targets": [],
                    "details_alignment": "left",
                    "volume_mode": "slider",
                    "volume_step": 0.02,
                    "collapse_on_idle": false,
                    "hide_menu_player": false,
                    "extend_artwork": false,
                    "card_height": "{# bedroom TV, under the speaker card; the two fill the screen below the light sliders. Alone 628/724; with the speaker shown: TV muted -> 145 strip, speaker muted -> the rest, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_bedroom_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_bedroom_vpe_speaker', 'is_volume_muted', true) %}\n{% set pair = (620 if clock_shown else 716) %}\n{% if states('media_player.mass_bedroom_vpe_speaker') not in ['off', 'idle', 'unavailable'] %}\n{{ (145 if tv_m and not mu_m else ((pair - 145) if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (628 if clock_shown else 724) }}\n{% endif %}",
                    "idle_timeout_ms": 0,
                    "card_mod": {
                      "style": "{# TV mute button (Maxi 2026-10-25: a way to unmute the muted TV). Below 320 px YAMP hides the volume row's mute button with an inline style; show it again (not while the options sheet is open).\nIn the strip (TV muted, music not) the volume row sits below the visible card, so lift the button into the play/skip row, left edge, styled like those buttons. #}\n{% set tv_m = is_state_attr('media_player.universal_bedroom_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_bedroom_vpe_speaker', 'is_volume_muted', true) %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  visibility: visible !important;\n  opacity: 1 !important;\n  pointer-events: auto !important;\n}\n{% if tv_m and not mu_m %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  transform: translate(-44px, -50px);\n}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] .volume-icon-btn {\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);\n}\n{% endif %}\n"
                    }
                  }
