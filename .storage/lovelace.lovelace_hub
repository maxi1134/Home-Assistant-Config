                },
                {
                  "cards": [
                    {
                      "type": "vertical-stack",
                      "cards": [
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "or",
                              "conditions": [
                                {
                                  "condition": "state",
                                  "entity": "media_player.mass_patio_wiim_speaker",
                                  "state_not": [
                                    "off",
                                    "idle"
                                  ]
                                },
                                {
                                  "condition": "and",
                                  "conditions": [
                                    {
                                      "condition": "or",
                                      "conditions": [
                                        {
                                          "condition": "state",
                                          "entity": "input_boolean.party_mode",
                                          "state": "on"
                                        },
                                        {
                                          "condition": "state",
                                          "entity": "input_boolean.kink_party",
                                          "state": "on"
                                        },
                                        {
                                          "condition": "state",
                                          "entity": "input_boolean.acid_time",
                                          "state": "on"
                                        }
                                      ]
                                    },
                                    {
                                      "condition": "state",
                                      "entity": "media_player.universal_patio_chromecast",
                                      "state": [
                                        "off",
                                        "unavailable"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "card": {
                            "type": "custom:yet-another-media-player",
                            "entities": [
                              {
                                "entity_id": "media_player.mass_patio_wiim_speaker"
                              }
                            ],
                            "card_type": "default",
                            "dim_chips_on_idle": true,
                            "appearance": "dark",
                            "alternate_progress_bar": true,
                            "match_theme": true,
                            "display_timestamps": true,
                            "search_view": "list",
                            "control_layout": "classic",
                            "swap_pause_for_stop": false,
                            "adaptive_controls": true,
                            "hide_active_entity_label": false,
                            "adaptive_text_targets": [],
                            "details_alignment": "left",
                            "volume_mode": "slider",
                            "volume_step": 0.02,
                            "collapse_on_idle": false,
                            "hide_menu_player": false,
                            "extend_artwork": false,
                            "card_height": "{# patio speaker, above the TV card: alone it fills down to the music covers row (434.83/514.83; kink/acid hide the clock row); with the TV shown the light-mode buttons hide and the pair fills to the bottom edge: TV muted -> the rest, speaker muted -> 110 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_patio_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_patio_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (636.17 if clock_shown else 716.17) %}\n{% if states('media_player.universal_patio_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 145) if tv_m and not mu_m else (110 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (434.83 if clock_shown else 514.83) }}\n{% endif %}",
                            "always_show_lyrics": true,
                            "lyrics_mode": "default",
                            "lyrics_pre_roll": 0,
                            "lyrics_source": "mass_lrclib",
                            "queue_controls_style": "drag_handle",
                            "idle_timeout_ms": 0,
                            "card_mod": {
                              "style": "{# ☰ room (follow-up to Maxi's 2026-10-25 mute split): below 320 px this classic-layout YAMP drops its volume row and floats ☰ at the bottom right of the play row, where it covered the power button. While compact, keep room for it.\nThe block below is a copy of this card's card_height; keep the two in sync. #}\n{% set h %}{# patio speaker, above the TV card: alone it fills down to the music covers row (434.83/514.83; kink/acid hide the clock row); with the TV shown the light-mode buttons hide and the pair fills to the bottom edge: TV muted -> the rest, speaker muted -> 110 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_patio_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_patio_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (636.17 if clock_shown else 716.17) %}\n{% if states('media_player.universal_patio_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 145) if tv_m and not mu_m else (110 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (434.83 if clock_shown else 514.83) }}\n{% endif %}{% endset %}\n{% if (h | trim | float(999)) < 320 %}\n.controls-row.adaptive {\n  padding-right: 52px !important;\n  --yamp-control-gap: 4px !important;\n  --yamp-control-min-width: 36px !important;\n}\n{% endif %}\n"
                            }
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "media_player.universal_patio_chromecast",
                              "state_not": [
                                "off",
                                "unavailable"
                              ]
                            }
                          ],
                          "card": {
                            "type": "custom:yet-another-media-player",
                            "entities": [
                              {
                                "entity_id": "media_player.universal_patio_chromecast"
                              }
                            ],
                            "card_type": "default",
                            "dim_chips_on_idle": true,
                            "appearance": "dark",
                            "alternate_progress_bar": false,
                            "match_theme": false,
                            "display_timestamps": true,
                            "search_view": "card_minimal",
                            "control_layout": "modern",
                            "swap_pause_for_stop": false,
                            "adaptive_controls": false,
                            "hide_active_entity_label": false,
                            "adaptive_text_targets": [],
                            "details_alignment": "left",
                            "volume_mode": "slider",
                            "volume_step": 0.02,
                            "collapse_on_idle": false,
                            "hide_menu_player": false,
                            "extend_artwork": false,
                            "card_height": "{# patio TV, under the speaker card. Alone it fills the slot like the speaker card (434.83/514.83; music covers stay on screen under it); with the speaker shown the light-mode buttons hide and the pair fills the screen to the bottom edge: TV muted -> 145 strip, speaker muted -> the rest, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_patio_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_patio_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (636.17 if clock_shown else 716.17) %}\n{% if states('media_player.mass_patio_wiim_speaker') not in ['off', 'idle'] %}\n{{ (145 if tv_m and not mu_m else ((pair - 110) if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (434.83 if clock_shown else 514.83) }}\n{% endif %}",
                            "idle_timeout_ms": 0,
                            "card_mod": {
                              "style": "{# TV mute button (Maxi 2026-10-25: a way to unmute the muted TV). Below 320 px YAMP hides the volume row's mute button with an inline style; show it again (not while the options sheet is open).\nIn the strip (TV muted, music not) the volume row sits below the visible card, so lift the button into the play/skip row, left edge, styled like those buttons. #}\n{% set tv_m = is_state_attr('media_player.universal_patio_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_patio_wiim_speaker', 'is_volume_muted', true) %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  visibility: visible !important;\n  opacity: 1 !important;\n  pointer-events: auto !important;\n}\n{% if tv_m and not mu_m %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  transform: translate(-44px, -50px);\n}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] .volume-icon-btn {\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);\n}\n{% endif %}\n"
                            }
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "media_player.mass_patio_wiim_speaker",
                              "state": [
