                            "show_color_control": true,
                            "tap_action": {
                              "action": "toggle"
                            },
                            "hold_action": {
                              "action": "toggle"
                            },
                            "double_tap_action": {
                              "action": "toggle"
                            },
                            "card_mod": {
                              "style": {
                                ".": "/* Maxi 2026-10-25: standard light block on every tablet: hue row (shown while the room is on), 48.75px bar */\nha-card {\n  --mush-icon-size: 48.75px;\n  --icon-size: 48.75px;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\n",
                                "mushroom-light-color-control$": {
                                  "mushroom-slider$": ".slider {\n  animation: ping 1.6s infinite;\n}\n@keyframes ping {\n  0% { box-shadow: 0 0 0 0 rgba(var(--rgb-white), 0.7); }\n  70% { box-shadow: 0 0 0 10px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n"
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "light.group_kitchen_lights",
                              "state_not": "on"
                            }
                          ],
                          "card": {
                            "type": "button",
                            "entity": "light.group_kitchen_lights",
                            "show_name": false,
                            "show_icon": false,
                            "show_state": false,
                            "tap_action": {
                              "action": "toggle"
                            },
                            "hold_action": {
                              "action": "toggle"
                            },
                            "double_tap_action": {
                              "action": "toggle"
                            },
                            "card_mod": {
                              "style": "/* Maxi 2026-10-25: standard light block on every tablet: hue row while the room is off. Mushroom can't draw its colour slider when the light is off at page load, so a dimmed rainbow (same size) stands in; tap turns the room on. */\nha-card {\n  height: 66.75px !important;\n  padding: 9px !important;\n  box-sizing: border-box;\n  display: block !important;\n  box-shadow: none !important;\n  border: none !important;\n  border-radius: 0 !important;\n  background: none !important;\n}\nha-card::before {\n  content: \"\";\n  display: block;\n  height: 48.75px;\n  border-radius: var(--control-border-radius, 12px);\n  background: linear-gradient(to right, #ff0000, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000);\n  filter: saturate(0.45) brightness(0.5);\n  animation: ping 1.6s infinite;\n}\n@keyframes ping {\n  0% { box-shadow: 0 0 0 0 rgba(var(--rgb-white), 0.7); }\n  70% { box-shadow: 0 0 0 10px transparent; }\n  100% { box-shadow: 0 0 0 0 transparent; }\n}\n"
                            }
                          }
                        }
                      ],
                      "card_mod": {
                        "style": "/* Maxi 2026-10-25: standard light block on every tablet: one box, 135.5px (keeps the space the old light cards used) */\nha-card {\n  height: 135.5px !important;\n  overflow: hidden;\n}\n"
                      }
                    },
                    {
                      "type": "custom:flipdown-timer-card",
                      "entity": "timer.cooking",
                      "show_hour": false,
                      "show_title": false,
                      "show_header": false,
                      "theme": "dark",
