                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.group_mass_home_group_speakers",
                          "state_not": "off"
                        },
                        {
                          "condition": "not",
                          "conditions": [
                            {
                              "condition": "and",
                              "conditions": [
                                {
                                  "condition": "state",
                                  "entity": "media_player.universal_kitchen_chromecast",
                                  "state_not": [
                                    "off",
                                    "unavailable"
                                  ]
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.mass_kitchen_wiim_speaker",
                                  "attribute": "is_volume_muted",
                                  "state": "true"
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.universal_kitchen_chromecast",
                                  "attribute": "is_volume_muted",
                                  "state_not": "true"
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "card": {
                        "type": "custom:vertical-stack-in-card",
                        "cards": [
                          {
                            "type": "iframe",
                            "url": "http://192.168.0.15:8095/#/party?frameless=true",
                            "aspect_ratio": "85%",
                            "hide_background": false,
                            "card_mod": {
                              "style": "{# fill the screen down to the controls: kink/acid hide the clock row (+96px); TV shown under it: size the iframe so this card (iframe + ~111px of controls) takes its share: TV muted -> the space minus the TV strip, music muted (TV not) -> this block hides and the WiiM YAMP is the speaker's strip (Maxi 2026-10-25: a muted speaker's strip is a small YAMP with its title, not the MA block's untitled control rows), both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_kitchen_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_kitchen_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (787 if clock_shown else 883) %}\n{% if states('media_player.universal_kitchen_chromecast') not in ['off', 'unavailable'] %}\n#root {\n  padding-top: 0 !important;\n  height: {{ (pair - 145 - 111) if tv_m and not mu_m else pair / 2 - 111 }}px !important;\n}\n{% else %}\n#root {\n  padding-top: {{ 85.84 if clock_shown else 97.88 }}% !important;\n}\n{% endif %}"
                            }
                          },
                          {
                            "type": "custom:mushroom-media-player-card",
                            "entity": "media_player.mass_kitchen_wiim_speaker",
                            "volume_controls": [
                              "volume_buttons",
                              "volume_set",
                              "volume_mute"
                            ],
                            "fill_container": false,
                            "show_volume_level": false,
                            "use_media_info": false,
                            "media_controls": [],
                            "collapsible_controls": false,
                            "layout": "vertical",
                            "icon": "none",
                            "icon_type": "none",
                            "primary_info": "none",
                            "secondary_info": "none"
                          },
                          {
                            "type": "custom:mushroom-media-player-card",
                            "entity": "media_player.mass_kitchen_wiim_speaker",
                            "volume_controls": [],
                            "fill_container": false,
                            "show_volume_level": true,
                            "use_media_info": false,
                            "media_controls": [
                              "previous",
                              "play_pause_stop",
                              "next",
                              "repeat",
                              "on_off",
                              "shuffle"
                            ],
                            "collapsible_controls": false,
                            "layout": "vertical",
                            "secondary_info": "none",
                            "primary_info": "none",
                            "icon_type": "none"
                          }
                        ]
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "or",
                          "conditions": [
                            {
                              "condition": "and",
                              "conditions": [
                                {
                                  "condition": "state",
                                  "entity": "media_player.group_mass_home_group_speakers",
                                  "state": "off"
                                },
                                {
                                  "condition": "or",
                                  "conditions": [
                                    {
                                      "condition": "state",
                                      "entity": "media_player.mass_kitchen_wiim_speaker",
                                      "state_not": [
                                        "off",
                                        "idle"
                                      ]
                                    },
                                    {
                                      "condition": "and",
                                      "conditions": [
                                        {
                                          "condition": "state",
                                          "entity": "media_player.universal_kitchen_chromecast",
                                          "state": [
                                            "off",
                                            "unavailable"
                                          ]
                                        },
                                        {
                                          "condition": "or",
                                          "conditions": [
                                            {
                                              "condition": "state",
                                              "entity": "input_boolean.party_mode",
                                              "state": "on"
                                            },
                                            {
                                              "condition": "state",
                                              "entity": "input_boolean.kink_party",
                                              "state": "on"
                                            },
                                            {
                                              "condition": "state",
                                              "entity": "input_boolean.acid_time",
                                              "state": "on"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "condition": "and",
                              "conditions": [
                                {
                                  "condition": "state",
                                  "entity": "media_player.group_mass_home_group_speakers",
                                  "state_not": "off"
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.universal_kitchen_chromecast",
                                  "state_not": [
                                    "off",
                                    "unavailable"
                                  ]
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.mass_kitchen_wiim_speaker",
                                  "attribute": "is_volume_muted",
                                  "state": "true"
                                },
                                {
                                  "condition": "state",
                                  "entity": "media_player.universal_kitchen_chromecast",
                                  "attribute": "is_volume_muted",
                                  "state_not": "true"
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "card": {
                        "type": "custom:yet-another-media-player",
                        "lyrics_source": "mass_lrclib",
                        "entities": [
                          {
                            "entity_id": "media_player.mass_kitchen_wiim_speaker"
                          }
                        ],
                        "card_type": "default",
                        "dim_chips_on_idle": true,
                        "appearance": "dark",
                        "alternate_progress_bar": false,
                        "match_theme": false,
                        "display_timestamps": true,
                        "search_view": "card_minimal",
                        "control_layout": "modern",
                        "swap_pause_for_stop": false,
                        "adaptive_controls": false,
                        "hide_active_entity_label": false,
                        "adaptive_text_targets": [],
                        "details_alignment": "left",
                        "volume_mode": "slider",
                        "volume_step": 0.02,
                        "collapse_on_idle": false,
                        "hide_menu_player": false,
                        "extend_artwork": false,
                        "card_height": "{# kitchen WiiM, above the TV card (while the MA group plays it is also the speaker's strip: WiiM muted under a shown, unmuted TV; Maxi 2026-10-25: a muted speaker's strip is a small YAMP with its title, not the MA block's untitled control rows): alone 795/891 (kink/acid hide the clock row); with the TV shown: TV muted -> the space minus the TV strip, WiiM muted -> 145 strip, both or neither muted -> half (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_kitchen_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_kitchen_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (787 if clock_shown else 883) %}\n{% if states('media_player.universal_kitchen_chromecast') not in ['off', 'unavailable'] %}\n{{ ((pair - 145) if tv_m and not mu_m else (145 if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (795 if clock_shown else 891) }}\n{% endif %}",
                        "always_show_lyrics": true,
                        "lyrics_mode": "default",
                        "lyrics_pre_roll": 0,
                        "search_results_sort": "play_count_desc",
                        "idle_timeout_ms": 0,
                        "card_mod": {
                          "style": "{# Speaker mute button (Maxi 2026-10-25: a muted speaker's strip is a small YAMP with its title, not the MA block's untitled control rows; the block's control rows had one). Below 320 px YAMP hides the volume row's mute button with an inline style; show it again (not while the options sheet is open).\nIn the strip (speaker muted, TV not) the volume row sits below the visible card, so lift the button into the play/skip row, left edge, styled like those buttons (same as the TV card's). #}\n{% set tv_m = is_state_attr('media_player.universal_kitchen_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_kitchen_wiim_speaker', 'is_volume_muted', true) %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  visibility: visible !important;\n  opacity: 1 !important;\n  pointer-events: auto !important;\n}\n{% if mu_m and not tv_m %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  transform: translate(-44px, -50px);\n}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] .volume-icon-btn {\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);\n}\n{% endif %}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "media_player.universal_kitchen_chromecast",
                          "state_not": "off"
                        },
                        {
                          "condition": "state",
                          "entity": "media_player.universal_kitchen_chromecast",
                          "state_not": "unavailable"
                        }
                      ],
                      "card": {
                        "type": "custom:yet-another-media-player",
                        "entities": [
                          {
                            "entity_id": "media_player.universal_kitchen_chromecast"
                          }
                        ],
                        "card_type": "default",
                        "dim_chips_on_idle": true,
                        "appearance": "dark",
                        "alternate_progress_bar": false,
                        "match_theme": false,
                        "display_timestamps": true,
                        "search_view": "card_minimal",
                        "control_layout": "modern",
                        "swap_pause_for_stop": false,
                        "adaptive_controls": false,
                        "hide_active_entity_label": false,
                        "adaptive_text_targets": [],
                        "details_alignment": "left",
                        "volume_mode": "slider",
                        "volume_step": 0.02,
                        "collapse_on_idle": false,
                        "hide_menu_player": false,
                        "extend_artwork": false,
                        "card_height": "{# kitchen TV, under the music card. Alone 795/891; with the music card shown the pair fills the space below the timer: TV muted -> 145 strip, music muted -> the music card is a 145 YAMP strip (with the MA group playing the WiiM YAMP stands in for the block; Maxi 2026-10-25: a muted speaker's strip is a small YAMP with its title, not the MA block's untitled control rows), both or neither muted -> half each (Maxi 2026-10-25: music card on top, TV under it; a muted player shrinks to a strip, both or neither muted -> half each) #}\n{% set k = states('media_player.mass_kitchen_wiim_speaker') %}\n{% set g = states('media_player.group_mass_home_group_speakers') %}\n{% set clock_shown = is_state('input_boolean.kink_party', 'off') and is_state('input_boolean.acid_time', 'off') %}\n{% set tv_m = is_state_attr('media_player.universal_kitchen_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_kitchen_wiim_speaker', 'is_volume_muted', true) %}\n{% set pair = (787 if clock_shown else 883) %}\n{% if g != 'off' or k not in ['off', 'idle'] %}\n{{ (145 if tv_m and not mu_m else ((pair - 145) if mu_m and not tv_m else pair / 2)) }}\n{% else %}\n{{ (795 if clock_shown else 891) }}\n{% endif %}",
                        "idle_timeout_ms": 0,
                        "card_mod": {
                          "style": "{# TV mute button (Maxi 2026-10-25: a way to unmute the muted TV). Below 320 px YAMP hides the volume row's mute button with an inline style; show it again (not while the options sheet is open).\nIn the strip (TV muted, music not) the volume row sits below the visible card, so lift the button into the play/skip row, left edge, styled like those buttons. #}\n{% set tv_m = is_state_attr('media_player.universal_kitchen_chromecast', 'is_volume_muted', true) %}\n{% set mu_m = is_state_attr('media_player.mass_kitchen_wiim_speaker', 'is_volume_muted', true) %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  visibility: visible !important;\n  opacity: 1 !important;\n  pointer-events: auto !important;\n}\n{% if tv_m and not mu_m %}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] {\n  transform: translate(-44px, -50px);\n}\ndiv:not([style*=\"visibility:hidden\"]) + .volume-row .volume-left > div:last-child[style*=\"visibility:hidden\"] .volume-icon-btn {\n  width: 38px;\n  height: 38px;\n  min-width: 38px;\n  min-height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);\n}\n{% endif %}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "input_boolean.party_mode",
                          "state": "off"
