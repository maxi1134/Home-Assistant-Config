        },
        {
          "title": "salon Hub",
          "path": "salon-hub",
          "theme": "redwave",
          "type": "panel",
          "cards": [
            {
              "type": "horizontal-stack",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "input_boolean.kink_party",
                          "state": "off"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.acid_time",
                          "state": "off"
                        }
                      ],
                      "card": {
                        "type": "custom:layout-card",
                        "layout_type": "custom:grid-layout",
                        "layout": {
                          "grid-template-columns": "85% auto",
                          "grid-template-rows": "auto",
                          "grid-template-areas": "\"clock temperature\"\n"
                        },
                        "cards": [
                          {
                            "type": "clock",
                            "clock_style": "digital",
                            "clock_size": "small",
                            "show_seconds": true,
                            "no_background": false,
                            "view_layout": {
                              "grid-area": "clock"
                            },
                            "date_format": [
                              "weekday-long",
                              "day-2-digit",
                              "month-long",
                              "year-numeric"
                            ]
                          },
                          {
                            "type": "markdown",
                            "content": "<center>    {{states(\"sensor.outside_temperature_with_fallback\")+\"°\" }} </center>",
                            "card_mod": {
                              "style": "ha-card {\n  font-size: 24px;\n}\n"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "horizontal-stack",
                      "cards": [
                        {
                          "type": "conditional",
                          "conditions": [
                            {
                              "entity": "input_boolean.kink_party",
                              "state": "off"
                            },
                            {
                              "entity": "input_boolean.acid_time",
                              "state": "off"
                            }
                          ],
                          "card": {
                            "content": "<center>  {{ now().strftime(' %A')  }} {{ now().strftime(' %d %B %Y  ')  }} |   Temperature: {{ states(\"sensor.sensor_outside_temperature_temperature\")+\"°\" if  (states(\"sensor.sensor_outside_temperature_temperature\") != 'unavailable') else states(\"weather.weather_montreal_forecast\")+\"*\" }}| {{now().strftime('%H:%M %p')}} </center>",
                            "type": "markdown",
                            "card_mod": {
                              "style": "ha-card {\n  font-size: 24px;\n}\n"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "custom:mushroom-light-card",
                      "entity": "light.group_salon_lights",
                      "fill_container": true,
                      "primary_info": "none",
                      "use_light_color": true,
                      "show_brightness_control": true,
                      "show_color_control": false,
                      "icon_type": "none",
                      "layout": "horizontal",
                      "secondary_info": "none",
                      "collapsible_controls": false,
                      "show_color_temp_control": true,
                      "card_mod": {
                        "style": "ha-card {\n  --control-height: 30px\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-light-card",
