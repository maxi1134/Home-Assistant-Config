                        "extend_artwork": false,
                        "card_height": "{# middle column ends level with the left one (y=794): 410 alone; 232 under the weather card, which shows whenever the WiiM is not playing #}\n{{ 410 if is_state('media_player.mass_hallway_wiim_speaker', 'playing') else 232 }}",
                        "always_show_lyrics": true,
                        "lyrics_mode": "default",
                        "lyrics_pre_roll": 0,
