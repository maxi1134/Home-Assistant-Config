                  "type": "tile",
                  "entity": "sensor.frigate_coral_inference_speed",
                  "grid_options": {
                    "columns": 12
                  },
                  "name": "Coral inference",
                  "icon": "mdi:chip"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Low batteries",
                  "icon": "mdi:battery-alert"
                },
                {
                  "type": "custom:battery-state-card",
                  "title": "",
                  "sort": {
                    "by": "state"
                  },
                  "collapse": 10,
                  "secondary_info": "{last_changed}",
                  "filter": {
                    "include": [
                      {
                        "name": "attributes.device_class",
                        "value": "battery"
                      }
                    ],
                    "exclude": [
                      {
                        "name": "entity_id",
                        "value": "binary_sensor.*"
                      },
                      {
                        "name": "entity_id",
                        "value": "sensor.phone_*"
                      },
                      {
                        "name": "state",
                        "value": 30,
                        "operator": ">="
                      }
                    ]
                  },
                  "bulk_rename": [
                    {
                      "from": " Battery level"
                    },
                    {
                      "from": " Battery"
                    },
                    {
                      "from": " battery"
                    }
                  ],
                  "colors": {
                    "steps": [
                      "#ff0000",
                      "#ffa500",
                      "#ffff00"
                    ],
                    "gradient": true
                  },
                  "grid_options": {
                    "columns": 12
                  }
                }
              ]
            },
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "heading",
                  "heading": "Updates",
                  "icon": "mdi:package-up"
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "entities",
                    "state_color": true
                  },
                  "filter": {
                    "include": [
                      {
                        "domain": "update",
                        "state": "on"
                      }
                    ],
                    "exclude": []
                  },
                  "sort": {
                    "method": "friendly_name"
                  },
                  "show_empty": true,
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Lab",
                  "icon": "mdi:flask-outline",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "/maxi-lab"
                  }
                },
                {
                  "type": "markdown",
                  "grid_options": {
                    "columns": 12
                  },
                  "content": "Scratch views (WIP, test, testing v2, Random, Zwave, ESP32, Phone, Tablets) live in **[Maxi Lab](/maxi-lab)**."
                }
              ]
            }
