{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.maxi_pc_next",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home-variant",
          "theme": "Backend-selected",
          "type": "sections",
          "max_columns": 4,
          "dense_section_placement": true,
          "header": {
            "layout": "start",
            "badges_position": "bottom",
            "card": {
              "type": "markdown",
              "text_only": true,
              "content": "# {{ 'Good morning' if now().hour < 12 else 'Good afternoon' if now().hour < 18 else 'Good evening' }}, Maxi\n{{ states('sensor.maxi_location_by_petro_v2') | title }} · {{ states('sensor.maxi_current_activity_v3') }}{{ ' · home alone' if is_state('binary_sensor.maxi_alone', 'on') }}"
            }
          },
          "badges": [
            {
              "type": "entity",
              "entity": "alarm_control_panel.home_alarm",
              "name": "Alarm",
              "show_name": true,
              "tap_action": {
                "action": "navigate",
                "navigation_path": "security"
              }
            },
            {
              "type": "entity",
              "entity": "lock.lock_front_door",
              "name": "Front door",
              "show_name": true
            },
            {
              "type": "entity",
              "entity": "lock.back_door",
              "name": "Back door",
              "show_name": true
            },
            {
              "type": "entity",
              "entity": "sensor.doors_open",
              "name": "Doors open",
              "show_name": true,
              "icon": "mdi:door-open",
              "color": "amber",
              "visibility": [
                {
                  "condition": "numeric_state",
                  "entity": "sensor.doors_open",
                  "above": 0
                }
              ]
            },
            {
              "type": "entity",
              "entity": "sensor.room_lights_on",
              "name": "Lights on",
              "show_name": true,
              "color": "amber",
              "tap_action": {
                "action": "navigate",
                "navigation_path": "lights"
              }
            },
            {
              "type": "entity",
              "entity": "sensor.inside_temperature",
              "name": "Inside",
              "show_name": true
            },
            {
              "type": "entity",
              "entity": "weather.forecast_home",
              "show_name": false,
              "state_content": [
                "state",
                "temperature"
              ]
            }
          ],
          "sections": [
