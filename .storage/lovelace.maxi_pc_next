        {
          "title": "System",
          "path": "system",
          "icon": "mdi:server",
          "theme": "Backend-selected",
          "type": "sections",
          "max_columns": 4,
          "dense_section_placement": true,
          "badges": [
            {
              "type": "entity",
              "entity": "sensor.pending_updates",
              "name": "Updates",
              "show_name": true,
              "color": "blue"
            },
            {
              "type": "entity",
              "entity": "sensor.low_batteries",
              "name": "Low batteries",
              "show_name": true,
              "color": "orange"
            },
            {
              "type": "entity",
              "entity": "sensor.system_monitor_processor_temperature",
              "name": "HA CPU temp",
              "show_name": true
            },
            {
              "type": "entity",
              "entity": "sensor.proxmox_ups_status",
              "name": "UPS",
              "show_name": true
            },
            {
              "type": "entity",
              "entity": "sensor.frigate_status",
              "name": "Frigate",
              "show_name": true,
              "icon": "mdi:cctv"
            }
          ],
          "sections": [
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "heading",
                  "heading": "Home Assistant host",
                  "icon": "mdi:home-assistant"
                },
                {
                  "type": "gauge",
                  "entity": "sensor.processor_use",
                  "name": "CPU",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 60,
                    "red": 85
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  }
                },
                {
                  "type": "gauge",
                  "entity": "sensor.memory_use_percent",
                  "name": "Memory",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 70,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  }
                },
                {
                  "type": "gauge",
                  "entity": "sensor.disk_use_percent",
                  "name": "Disk",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 70,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  }
                },
                {
                  "type": "gauge",
                  "entity": "sensor.system_monitor_processor_temperature",
                  "name": "CPU temp",
                  "min": 30,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 65,
                    "red": 80
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  }
                },
                {
                  "type": "heading",
                  "heading": "UPS (Proxmox)",
                  "icon": "mdi:power-plug-battery",
                  "heading_style": "subtitle"
                },
                {
                  "type": "gauge",
                  "entity": "sensor.proxmox_ups_battery_charge",
                  "name": "Charge",
                  "needle": true,
                  "severity": {
                    "red": 0,
                    "yellow": 30,
                    "green": 60
                  },
                  "grid_options": {
                    "columns": 8,
                    "rows": 3
                  }
                },
                {
                  "type": "gauge",
                  "entity": "sensor.proxmox_ups_load",
                  "name": "Load",
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 60,
                    "red": 85
                  },
                  "grid_options": {
                    "columns": 8,
                    "rows": 3
                  }
                },
                {
